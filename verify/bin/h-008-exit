#!/usr/bin/env bash
# h-008-exit — skiva 6b (taskkuvert, v4.1 §12)
# Kontrakt: controller/envelope/cli build <run-id> <task-id> <base-sha>
#           → 0 med kuvertet som JSON på stdout, ≠0 med orsak på stdout annars.
. "$(dirname "$0")/_lib.sh"
CLI="controller/envelope/cli"
krav_komponent "$CLI"

tmp=$(temp_kat); trap 'rm -rf "$tmp"' EXIT
[ -n "$tmp" ] && [ -d "$tmp" ] || { echo "FAIL  K0 temp — temp_kat gav ingen katalog"; echo; echo "0 PASS, 1 FAIL"; exit 1; }
BASE=$(git rev-parse HEAD)
SPECSHA=$(shasum -a 256 specs/tasks.spec.json | cut -d' ' -f1)

# K1: kuvert för känd task byggs och är giltig JSON
ut=$("$CLI" build run-prov h-001 "$BASE" 2>&1); kod=$?
if [ "$kod" -ne 0 ]; then
  no "K1 bygger kuvert" "kod=$kod [$ut]"
else
  echo "$ut" > "$tmp/kuvert.json"
  if python3.12 -c "import json,sys; json.load(open(sys.argv[1]))" "$tmp/kuvert.json" 2>/dev/null; then
    ok "K1 kuvert för känd task byggs som giltig JSON"
  else
    no "K1 giltig JSON" "utdata går inte att parsa"
  fi
fi

# K2: alla nio fälten ur v4.1 §12 finns
if [ -s "$tmp/kuvert.json" ]; then
  saknas=$(python3.12 -c "
import json,sys
k=json.load(open(sys.argv[1]))
krav=['run_id','task_id','base_sha','spec_sha256','title','description','allowed_write','denied_write','candidate_requirements']
print(' '.join(f for f in krav if f not in k))
" "$tmp/kuvert.json" 2>/dev/null)
  if [ -z "$saknas" ]; then ok "K2 alla nio §12-fälten finns"
  else no "K2 §12-fälten" "saknas:$saknas"; fi
else
  no "K2 §12-fälten" "inget kuvert att pröva"
fi

# K3: spec_sha256 är filens FAKTISKA hash, inte ett påstått värde
if [ -s "$tmp/kuvert.json" ]; then
  h=$(python3.12 -c "import json,sys;print(json.load(open(sys.argv[1])).get('spec_sha256',''))" "$tmp/kuvert.json" 2>/dev/null)
  if [ "$h" = "$SPECSHA" ]; then ok "K3 spec_sha256 = filens faktiska hash"
  else no "K3 spec_sha256" "kuvert=[$h] faktisk=[$SPECSHA]"; fi
else
  no "K3 spec_sha256" "inget kuvert att pröva"
fi

# K4: allowed_write kommer ur SPECEN för just den tasken, inte ur en egen lista.
# h-001 och h-007 har OLIKA allowed_write — ett kuvert med hårdkodad lista fälls här.
u1=$("$CLI" build run-prov h-001 "$BASE" 2>/dev/null | python3.12 -c "import json,sys;print(sorted(json.load(sys.stdin).get('allowed_write',[])))" 2>/dev/null)
u7=$("$CLI" build run-prov h-007 "$BASE" 2>/dev/null | python3.12 -c "import json,sys;print(sorted(json.load(sys.stdin).get('allowed_write',[])))" 2>/dev/null)
s1=$(python3.12 -c "
import json
d=json.load(open('specs/tasks.spec.json'))
print(sorted([t for t in d['tasks'] if t['id']=='h-001'][0]['allowed_write']))
")
s7=$(python3.12 -c "
import json
d=json.load(open('specs/tasks.spec.json'))
print(sorted([t for t in d['tasks'] if t['id']=='h-007'][0]['allowed_write']))
")
if [ "$u1" = "$s1" ] && [ "$u7" = "$s7" ] && [ "$u1" != "$u7" ]; then
  ok "K4 allowed_write läses per task ur specen"
elif [ "$u1" = "$u7" ]; then
  no "K4 allowed_write" "h-001 och h-007 fick SAMMA lista — hårdkodad, inte läst"
else
  no "K4 allowed_write" "avviker från specen: h-001=[$u1] vs [$s1]"
fi

# K5: denied_write kommer ur defaults
if [ -s "$tmp/kuvert.json" ]; then
  ud=$(python3.12 -c "import json,sys;print(sorted(json.load(open(sys.argv[1])).get('denied_write',[])))" "$tmp/kuvert.json" 2>/dev/null)
  sd=$(python3.12 -c "import json;print(sorted(json.load(open('specs/tasks.spec.json'))['defaults']['denied_write']))")
  if [ "$ud" = "$sd" ]; then ok "K5 denied_write = defaults ur specen"
  else no "K5 denied_write" "kuvert=[$ud]"; fi
else
  no "K5 denied_write" "inget kuvert att pröva"
fi

# K6: okänd task-id → failure med orsak, aldrig tomt kuvert
ut=$("$CLI" build run-prov h-999 "$BASE" 2>&1); kod=$?
if [ "$kod" -eq 0 ]; then
  no "K6 okänd task" "h-999 accepterades"
elif [ -z "$ut" ]; then
  no "K6 okänd task" "avvisades tyst — kontraktet kräver orsak på stdout"
elif ! echo "$ut" | grep -qiE 'h-999|okänd|unknown|finns inte'; then
  no "K6 okänd task" "orsaken namnger inte tasken: [$ut]"
else
  ok "K6 okänd task-id → failure med orsak"
fi

# K7: två anrop med samma run_id + task_id ger BYTE-IDENTISKT kuvert
a=$("$CLI" build run-prov h-001 "$BASE" 2>/dev/null | shasum -a 256 | cut -d' ' -f1)
sleep 1
b=$("$CLI" build run-prov h-001 "$BASE" 2>/dev/null | shasum -a 256 | cut -d' ' -f1)
if [ -n "$a" ] && [ "$a" = "$b" ]; then
  ok "K7 kuvertet är deterministiskt (immutable per attempt)"
else
  no "K7 determinism" "två anrop gav olika kuvert ($a != $b) — tidsstämpel eller slump i kuvertet?"
fi

# K8: kuvertet bär INGET om verifierarens implementation (v4.1 §12)
if [ -s "$tmp/kuvert.json" ]; then
  # allowed_write och denied_write BÄR sökvägar ur specen med avsikt — defaults.denied_write
  # innehåller scripts/check-invariants.mjs. En grep över hela filen gör K5 och K8 ömsesidigt
  # oförenliga (funnet av h-008-sessionen 2026-08-08, som mätte att en JSON-escape hade gett
  # båda gröna och avstod). Grep:a därför kuvertet MINUS de två fälten.
  python3.12 -c "
import json,sys
k=json.load(open(sys.argv[1]))
for f in ('allowed_write','denied_write'): k.pop(f, None)
print(json.dumps(k, ensure_ascii=False))
" "$tmp/kuvert.json" > "$tmp/kuvert-utan-vagar.json"
  lack=""
  grep -qi 'verify/bin' "$tmp/kuvert-utan-vagar.json" && lack="$lack exit_test-sökväg"
  grep -qi 'register.json\|verifier_id' "$tmp/kuvert-utan-vagar.json" && lack="$lack verifierarreferens"
  if [ -n "$lack" ]; then
    no "K8 verifierarläckage" "kuvertet innehåller:$lack"
  else
    ok "K8 kuvertet bär inget om verifierarens implementation"
  fi
else
  no "K8 verifierarläckage" "inget kuvert att pröva"
fi

# K9: ingen krasch vid ogiltigt base-sha eller saknade argument
kras=""
err=$("$CLI" build run-prov h-001 0000000000000000000000000000000000000000 2>&1 >/dev/null)
echo "$err" | grep -qi 'traceback' && kras="$kras ogiltigt-sha"
err=$("$CLI" build 2>&1 >/dev/null)
echo "$err" | grep -qi 'traceback' && kras="$kras utan-argument"
if [ -n "$kras" ]; then
  no "K9 ingen krasch" "traceback för:$kras"
else
  ok "K9 ingen krasch vid ogiltigt SHA eller saknade argument"
fi

# K10: run_id, task_id och base_sha speglar ARGUMENTEN, inte konstanter.
# Lögnstubben skrev fyrtio nollor som base_sha och konstant run_id och passerade K2.
ut=$("$CLI" build kort-run-42 h-003 "$BASE" 2>/dev/null)
if [ -z "$ut" ]; then
  no "K10 argumentspegling" "inget kuvert byggdes"
else
  echo "$ut" > "$tmp/k10.json"
  fel=$(python3.12 -c "
import json,sys
k=json.load(open(sys.argv[1])); b=sys.argv[2]; f=[]
if k.get('run_id')!='kort-run-42': f.append(f\"run_id={k.get('run_id')}\")
if k.get('task_id')!='h-003': f.append(f\"task_id={k.get('task_id')}\")
if k.get('base_sha')!=b: f.append(f\"base_sha={k.get('base_sha')}\")
print(' '.join(f))
" "$tmp/k10.json" "$BASE" 2>/dev/null)
  if [ -z "$fel" ]; then ok "K10 run_id/task_id/base_sha speglar argumenten"
  else no "K10 argumentspegling" "avviker: $fel"; fi
fi

# K11: title och description kommer ur SPECEN för just den tasken.
# Två olika tasks måste ge olika text — tomma eller konstanta fält fälls.
t3=$("$CLI" build r h-003 "$BASE" 2>/dev/null | python3.12 -c "import json,sys;k=json.load(sys.stdin);print(k.get('title',''))" 2>/dev/null)
t5=$("$CLI" build r h-005 "$BASE" 2>/dev/null | python3.12 -c "import json,sys;k=json.load(sys.stdin);print(k.get('title',''))" 2>/dev/null)
s3=$(python3.12 -c "
import json
d=json.load(open('specs/tasks.spec.json'))
print([t for t in d['tasks'] if t['id']=='h-003'][0]['title'])
")
d3=$("$CLI" build r h-003 "$BASE" 2>/dev/null | python3.12 -c "import json,sys;print(len(json.load(sys.stdin).get('description','')))" 2>/dev/null)
if [ "$t3" != "$s3" ]; then
  no "K11 title/description" "title=[$t3] men specen säger [$s3]"
elif [ "$t3" = "$t5" ]; then
  no "K11 title/description" "h-003 och h-005 fick samma title — konstant, inte läst"
elif [ "${d3:-0}" -lt 20 ]; then
  no "K11 title/description" "description är $d3 tecken — tomt eller platshållare"
else
  ok "K11 title och description läses per task ur specen"
fi

# K12: candidate_requirements bär uppdraget, inte certifieringssteget.
cr=$("$CLI" build r h-003 "$BASE" 2>/dev/null | python3.12 -c "import json,sys;print(json.dumps(json.load(sys.stdin).get('candidate_requirements','')))" 2>/dev/null)
if [ "${#cr}" -lt 20 ]; then
  no "K12 candidate_requirements" "tomt eller platshållare: $cr"
elif echo "$cr" | grep -qi 'verify/bin\|exit_test\|verifier_id'; then
  no "K12 candidate_requirements" "läcker certifieringssteget: $cr"
else
  ok "K12 candidate_requirements bär uppdraget utan certifieringssteget"
fi
summera
