#!/usr/bin/env bash
# h-011-exit — skiva 9 (huvudloopen, kedjan)
# Kontrakt: controller/loop/cli run <config.json>
#   Config bär spec, attest_dir, state_dir, lease_dir, lease_resurs,
#   workspace_rot, base_sha, worker_cmd (argv-lista), timeout_s, verifier_id,
#   run_id. Exit 0 = körning slutförd (drain, även noll varv). Exit 1 = fel,
#   inklusive upptagen lease FÖRE första varvet.
# Varvet är v4.1 §13: select/claim → workspace på aktuell base → kuvert →
# launch → strikt parse → policy → verifierare mot kandidatträdet → attest.
# Integration = kedjande base. Failure attesterar aldrig; tasken förblir
# claimed. Workspacet rivs efter varvet — kandidatens commit är beviset.
# Effekter mäts via attest/state/git — aldrig via kedjans egen utsaga.
#
# K11–K15 binder de fem led vars frånvaro inte ändrade något mätbart utfall
# (lögnstubben som fick full pott, LOOP-H-011): den levande arbetskopian är
# orörd · workern bevisar plats och kuvert i kandidatens INNEHÅLL · timeout
# mäts på effekt (kanariefågel) · en blockerad task först i ordningen rörs
# aldrig (taskval, inte spec-ordning) · okänd verifierare attesterar aldrig.
# Grönt av slump är inte mätt.
#
# REVIDERAT FÖR h-016 (LOOP-ÄGARHAND-36). Kedjan går sedan skiva 14 genom
# brytaren och utföraren, och tre saker i detta prov mätte fel efter det:
#   (a) Configen bär tre nya fält — brytare_rot, budget, troskel — och prövas i
#       sin HELHET före leasen. Utan dem faller VARJE fall med exit 1 av ett
#       skäl som inte har med fixturerna att göra. brytare_rot härleds ur
#       workspace_rot, så inget av de sju anropsställena behöver ändras.
#   (b) FIXTURERNA COMMITTAR INTE LÄNGRE. Kandidat-SHA:t föds i controllerledet
#       (h-012); en session som stagar och committar själv ger exit 6
#       "sessionen committade själv" och därmed ingen kandidat alls. De
#       redigerar filer och inget mer — vilket också är den form drift har.
#   (c) K6 läste kandidat-SHA:t ur workerns egen utsaga. Efter inkopplingen
#       finns ingen sådan utsaga, och K6 och K15 grönade dessutom av fel skäl
#       när varvet dog TIDIGARE än det led de påstod sig mäta. K6 mäter nu
#       POLICYNS EGEN evidence-post — en systers tillstånd över processgränsen,
#       inte kedjans prat — och K15 har fått en kontrollkörning med registrerad
#       verifierare, så ett varv som aldrig nådde verifieraren inte kan fria.
#       K13 har av samma skäl fått en startmarkör: en kanarie som aldrig skrevs
#       bevisar ingen timeout om sessionen aldrig startade.
. "$(dirname "$0")/_lib.sh"
CLI="controller/loop/cli"
ATT="controller/attest/cli"
ST="controller/state/cli"
LE="controller/lease/cli"
EV="controller/policy/evidence"
krav_komponent "$CLI"
for dep in controller/taskval/cli controller/attest/cli controller/state/cli \
           controller/lease/cli controller/workspace/cli controller/worker/cli \
           controller/policy/cli controller/envelope/cli controller/launch/cli \
           controller/verify/cli controller/utforare/cli controller/brytare/cli; do
  if [ ! -x "$dep" ]; then
    echo "SKIP  harness — $dep saknas eller är inte körbar (h-011:s depends_on), testet är odömbart"
    echo; echo "$pass PASS, $fail FAIL, ODÖMBART"; exit 2
  fi
done

WORK="$(temp_kat)" || { echo "FAIL  harness — temp-katalog kunde inte skapas"; exit 2; }
# WORKTREE-LÄGET MÄTS I SIN HELHET, aldrig som en sökvägsmatchning på provets
# temp-katalog: en implementation som tappar rot-argumentet till h-005 hamnar i
# komponentens inbyggda <repo>/../worktrees, och en matchning på $WORK är blind
# för den — både när den ska rapporteras och när den ska städas.
wt_lista() { git worktree list --porcelain | sed -n 's/^worktree //p' | LC_ALL=C sort; }
# BEGRÄNSAD TILL KEDJANS TVÅ MÖJLIGA PLATSER, aldrig "allt nytt": en främmande
# worktree — eller husets andra grind körd samtidigt — hade annars fällt en
# korrekt kedja för något den aldrig gjort. Komponentens inbyggda rot är med
# eftersom ett tappat rot-argument leder dit.
WSROT_INBYGGD="$(cd "$(dirname "$(git rev-parse --show-toplevel)")" && pwd -P)/worktrees"
wt_nya() {
  wt_lista > "$WORK/wt-nu.txt"
  comm -13 "$WORK/wt-fore.txt" "$WORK/wt-nu.txt" | while IFS= read -r w; do
    case "$w" in
      "$WORK"/*|"$WORK_KANON"/*|"$WSROT_INBYGGD"/*) echo "$w" ;;
    esac
  done
}
stada() {
  if [ -f "$WORK/wt-fore.txt" ]; then
    wt_nya 2>/dev/null | while IFS= read -r w; do
      [ -n "$w" ] && controller/workspace/cli "$(dirname "$w")" destroy "$(basename "$w")" >/dev/null 2>&1
    done
  fi
  git worktree prune >/dev/null 2>&1
  rm -rf "$WORK"
}
trap stada EXIT
wt_lista > "$WORK/wt-fore.txt"
# macOS: temp ligger under /var som är symlänk till /private/var — git skriver
# kanonisk form, så all matchning sker mot pwd -P.
WORK_KANON="$(cd "$WORK" && pwd -P)"
PY3="$(command -v python3)"
BAS="$(git rev-parse HEAD)"
# GRINDENS EGNA TAL. BUDGET 1 håller varje h-011-fall vid exakt ETT försök —
# provets ämne är kedjan, inte omförsöket, och ett större tak hade multiplicerat
# väggtiden i timeout-fallet. TRÖSKEL 2 är STRIKT HÖGRE än budgeten: utförarens
# kod 6 fingerprintas, så en prosa-session (noll ändrade filer) hade med tröskel
# 1 öppnat brytaren och gjort K5:s väntade exit 0 till exit 3. Tröskeln kan med
# budget 1 aldrig nås, vilket är hela avsikten — h-016-exit är provet som mäter
# brytarens öppning, inte detta.
BUDGET=1
TROSKEL=2
FORE_SMUTS="$(git status --porcelain)"

# --- Fixturbacklogar. aa-sparr står FÖRST i kodpunktsordning men är blockerad:
# en kedja som itererar specordning i stället för att fråga taskval avslöjas.
cat > "$WORK/backlog.json" <<'JSON'
{
  "spec_version": "fixtur",
  "defaults": { "max_changed_files": 8, "max_added_lines": 600 },
  "tasks": [
    { "id": "aa-sparr", "slice": 0, "title": "sparr", "summary": "blockerad fixtur",
      "allowed_write": ["tests/kedjefix/**"], "exit_test": "verify/bin/ingen",
      "exit_criterion": "-", "docs_impact": [], "depends_on": ["finns-inte"] },
    { "id": "steg-a", "slice": 0, "title": "a", "summary": "kedjefixtur a",
      "allowed_write": ["tests/kedjefix/**"], "exit_test": "verify/bin/ingen",
      "exit_criterion": "-", "docs_impact": [], "depends_on": [] },
    { "id": "steg-b", "slice": 0, "title": "b", "summary": "kedjefixtur b",
      "allowed_write": ["tests/kedjefix/**"], "exit_test": "verify/bin/ingen",
      "exit_criterion": "-", "docs_impact": [], "depends_on": ["steg-a"] }
  ]
}
JSON
cat > "$WORK/prosa-backlog.json" <<'JSON'
{
  "spec_version": "fixtur",
  "defaults": { "max_changed_files": 8, "max_added_lines": 600 },
  "tasks": [
    { "id": "prosa-1", "slice": 0, "title": "p", "summary": "prosafixtur",
      "allowed_write": ["tests/kedjefix/**"], "exit_test": "verify/bin/ingen",
      "exit_criterion": "-", "docs_impact": [], "depends_on": [] }
  ]
}
JSON
cat > "$WORK/rogue-backlog.json" <<'JSON'
{
  "spec_version": "fixtur",
  "defaults": { "max_changed_files": 8, "max_added_lines": 600 },
  "tasks": [
    { "id": "rogue-1", "slice": 0, "title": "r", "summary": "roguefixtur",
      "allowed_write": ["tests/kedjefix/**"], "exit_test": "verify/bin/ingen",
      "exit_criterion": "-", "docs_impact": [], "depends_on": [] }
  ]
}
JSON
cat > "$WORK/seg-backlog.json" <<'JSON'
{
  "spec_version": "fixtur",
  "defaults": { "max_changed_files": 8, "max_added_lines": 600 },
  "tasks": [
    { "id": "seg-1", "slice": 0, "title": "s", "summary": "seg fixtur",
      "allowed_write": ["tests/kedjefix/**"], "exit_test": "verify/bin/ingen",
      "exit_criterion": "-", "docs_impact": [], "depends_on": [] }
  ]
}
JSON
cat > "$WORK/verif-backlog.json" <<'JSON'
{
  "spec_version": "fixtur",
  "defaults": { "max_changed_files": 8, "max_added_lines": 600 },
  "tasks": [
    { "id": "verif-1", "slice": 0, "title": "v", "summary": "verifierarfixtur",
      "allowed_write": ["tests/kedjefix/**"], "exit_test": "verify/bin/ingen",
      "exit_criterion": "-", "docs_impact": [], "depends_on": [] }
  ]
}
JSON

# --- Sessioner. De REDIGERAR och inget mer: stagar aldrig, committar aldrig.
# Utföraren (h-012) gör git-arbetet, och en session som committar själv ger
# exit 6 och därmed ingen kandidat. Ärlig bevisar PLATS och KUVERT i
# kandidatens innehåll.
cat > "$WORK/arlig.py" <<'W'
import json, os, sys
kuv = json.load(sys.stdin)
tid = kuv["task_id"]
os.makedirs("tests/kedjefix", exist_ok=True)
fil = f"tests/kedjefix/{tid}.txt"
open(fil, "w").write(
    f"kandidat for {tid}\ncwd={os.path.realpath(os.getcwd())}\nspec={kuv['spec_sha256']}\nrun={kuv['run_id']}\n")
print(f"redigerade {fil}")
W
cat > "$WORK/prosa.py" <<'W'
print("Jag ar klar! Allt gick fint och jag har gjort ett utmarkt jobb.")
W
cat > "$WORK/rogue.py" <<'W'
import json, os, sys
kuv = json.load(sys.stdin)
os.makedirs("tests", exist_ok=True)
fil = "tests/kedjefix-intrang.txt"
open(fil, "w").write("utanfor allowed_write\n")
print(f"redigerade {fil}")
W
# STARTMARKÖREN skrivs FÖRE sömnen och ligger utanför workspacet: en kanarie
# som aldrig skrevs bevisar ingen timeout om sessionen aldrig startade.
sed "s|@KANARIE@|$WORK/kanarie.txt|;s|@START@|$WORK/seg-start.txt|" > "$WORK/seg.py" <<'W'
import json, os, sys, time
kuv = json.load(sys.stdin)
open("@START@", "a").write("start\n")
time.sleep(5)
open("@KANARIE@", "w").write("levde forbi timeouten\n")
os.makedirs("tests/kedjefix", exist_ok=True)
open("tests/kedjefix/seg-1.txt", "w").write("seg kandidat\n")
print("hann anda fram")
W

skriv_config() {
cat > "$1" <<KONF
{ "spec": "$2", "attest_dir": "$3", "state_dir": "$4",
  "lease_dir": "$5", "lease_resurs": "kedjan", "workspace_rot": "$6",
  "base_sha": "$BAS", "worker_cmd": ["$PY3", "$7"], "timeout_s": $9,
  "verifier_id": "${10}", "run_id": "$8",
  "brytare_rot": "$6-br", "budget": $BUDGET, "troskel": $TROSKEL }
KONF
}
sha_ur_attest() { "$ATT" "$1" read "$2" 2>/dev/null | "$PY3" -c 'import json,sys; print(json.load(sys.stdin)["candidate_sha"])' 2>/dev/null; }
har_status() { "$ST" rebuild "$1" 2>/dev/null | "$PY3" -c 'import json,sys
d = {r["task"]: r["status"] for r in json.load(sys.stdin)}
sys.exit(0 if d.get(sys.argv[1]) == sys.argv[2] else 1)' "$2" "$3"; }
utan_status() { "$ST" rebuild "$1" 2>/dev/null | "$PY3" -c 'import json,sys
d = {r["task"] for r in json.load(sys.stdin)}
sys.exit(1 if sys.argv[1] in d else 0)' "$2"; }
rader() { wc -l < "$1/events.jsonl" | tr -d ' '; }
ev_antal() { ls "$EV" 2>/dev/null | grep -c "^$1-"; }
# Fältet ur policyns SENASTE evidence-post för tasken — systerns eget
# tillstånd över processgränsen, aldrig kedjans utsaga.
ev_falt() { "$PY3" - "$EV" "$1" "$2" <<'PY'
import json, os, sys
kat, task, falt = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    kand = [f for f in os.listdir(kat) if f.startswith(task + "-") and f.endswith(".json")]
except OSError:
    raise SystemExit
if not kand:
    raise SystemExit
kand.sort(key=lambda f: os.path.getmtime(os.path.join(kat, f)))
try:
    d = json.load(open(os.path.join(kat, kand[-1]), encoding="utf-8"))
except Exception:
    raise SystemExit
print(d.get(falt, ""))
PY
}

# --- A: solskensdrain, nu med blockerad spärrtask i backloggen.
A_AT="$WORK/a-att"; A_ST="$WORK/a-st"; A_LE="$WORK/a-le"; A_WS="$WORK/a-ws"
mkdir -p "$A_WS"; A_WS_KANON="$(cd "$A_WS" && pwd -P)"
"$ST" init "$A_ST" >/dev/null 2>&1
skriv_config "$WORK/config-a.json" "$WORK/backlog.json" "$A_AT" "$A_ST" "$A_LE" "$A_WS" "$WORK/arlig.py" kedja-a 60 check-invariants
"$CLI" run "$WORK/config-a.json" >"$WORK/a-ut.txt" 2>"$WORK/a-fel.txt"; kod_a=$?
if [ "$kod_a" -eq 0 ] && "$ATT" "$A_AT" read steg-a --require-valid >/dev/null 2>&1 \
   && "$ATT" "$A_AT" read steg-b --require-valid >/dev/null 2>&1; then
  ok "K1 drain attesterar båda: varv två blev behörigt av varv etts attestation"
else
  no "K1 kedjan" "exit ${kod_a} (väntat 0), attest steg-a/steg-b saknas eller ogiltig — första felrad: $(head -1 "$WORK/a-fel.txt" 2>/dev/null)"
fi
SHA_A="$(sha_ur_attest "$A_AT" steg-a)"; SHA_B="$(sha_ur_attest "$A_AT" steg-b)"
if [ -n "$SHA_B" ] && [ "$SHA_A" != "$SHA_B" ] && git cat-file -e "$SHA_B" 2>/dev/null \
   && [ -n "$(git ls-tree "$SHA_B" -- tests/kedjefix/steg-a.txt 2>/dev/null)" ]; then
  ok "K2 kedjande base: steg-b:s kandidatträd innehåller steg-a:s fil"
else
  no "K2 kausalitet" "steg-b:s kandidat '${SHA_B}' saknar tests/kedjefix/steg-a.txt i trädet — integration bygger inte på förra kandidaten"
fi
if [ -n "$SHA_A" ] && git cat-file -e "$SHA_A" 2>/dev/null \
   && [ -n "$(git diff --name-only "$BAS" "$SHA_A" 2>/dev/null)" ] \
   && [ -z "$(git diff --name-only "$BAS" "$SHA_A" 2>/dev/null | grep -v '^tests/kedjefix/')" ]; then
  ok "K3 riktiga commits inom allowed_write (diffen mot base är enbart tests/kedjefix/**)"
else
  no "K3 kandidatform" "steg-a:s kandidat '${SHA_A}' finns inte i git eller diffar utanför tests/kedjefix/**"
fi
if har_status "$A_ST" steg-a claimed && har_status "$A_ST" steg-b claimed; then
  ok "K4 state bär claimed för båda varven (rebuild, loggen är sanningen)"
else
  no "K4 state-effekt" "rebuild visar inte steg-a och steg-b som claimed"
fi
inneh="$(git show "$SHA_A:tests/kedjefix/steg-a.txt" 2>/dev/null)"
vantad_spec="$(shasum -a 256 "$WORK/backlog.json" | cut -d' ' -f1)"
if echo "$inneh" | grep -q "^cwd=$A_WS_KANON/" && echo "$inneh" | grep -q "^spec=$vantad_spec"; then
  ok "K12 workern körde i workspacet med rätt kuvert (cwd och spec_sha256 i kandidatens innehåll)"
else
  no "K12 plats- och kuvertbindning" "kandidatens innehåll bär inte cwd under workspace_rot och config-specens hash — workern körde någon annanstans eller fick fel kuvert"
fi
if utan_status "$A_ST" aa-sparr && ! "$ATT" "$A_AT" read aa-sparr >/dev/null 2>&1; then
  ok "K14 blockerad task först i ordningen rörs aldrig (taskval, inte spec-ordning)"
else
  no "K14 taskval-bindning" "aa-sparr claimades eller attesterades trots oattesterat beroende — kedjan itererar specordning i stället för att fråga taskval"
fi

# --- B: prosa-worker.
B_AT="$WORK/b-att"; B_ST="$WORK/b-st"; B_LE="$WORK/b-le"; B_WS="$WORK/b-ws"
mkdir -p "$B_WS"; "$ST" init "$B_ST" >/dev/null 2>&1
skriv_config "$WORK/config-b.json" "$WORK/prosa-backlog.json" "$B_AT" "$B_ST" "$B_LE" "$B_WS" "$WORK/prosa.py" kedja-b 60 check-invariants
"$CLI" run "$WORK/config-b.json" >/dev/null 2>&1; kod_b=$?
if [ "$kod_b" -eq 0 ] && ! "$ATT" "$B_AT" read prosa-1 --require-valid >/dev/null 2>&1 \
   && har_status "$B_ST" prosa-1 claimed; then
  ok "K5 prosa-rapport ger varv utan attestation, kedjan fortsätter till exit 0"
else
  no "K5 parse-utfallet" "exit ${kod_b} (väntat 0) — prosa attesterades eller varvet claimade aldrig"
fi

# --- C: rogue-worker.
C_AT="$WORK/c-att"; C_ST="$WORK/c-st"; C_LE="$WORK/c-le"; C_WS="$WORK/c-ws"
mkdir -p "$C_WS"; "$ST" init "$C_ST" >/dev/null 2>&1
skriv_config "$WORK/config-c.json" "$WORK/rogue-backlog.json" "$C_AT" "$C_ST" "$C_LE" "$C_WS" "$WORK/rogue.py" kedja-c 60 check-invariants
EV_FORE="$(ev_antal rogue-1)"
"$CLI" run "$WORK/config-c.json" >/dev/null 2>&1; kod_c=$?
EV_EFTER="$(ev_antal rogue-1)"
ROGUE_SHA="$(ev_falt rogue-1 candidate_sha)"
ROGUE_VERDIKT="$(ev_falt rogue-1 verdikt)"
if [ "$kod_c" -ne 0 ]; then
  no "K6 kedjan fortsätter efter policyavslag" "exit ${kod_c} (väntat 0)"
elif [ "$((EV_EFTER - EV_FORE))" -lt 1 ]; then
  no "K6 varvet nådde policyn" "policyns evidence växte inte för rogue-1 — varvet dog FÖRE h-007, och kontrollen hade grönat av fel skäl"
elif ! echo "$ROGUE_SHA" | grep -Eq '^[0-9a-f]{40}$' || ! git cat-file -e "$ROGUE_SHA" 2>/dev/null; then
  no "K6 kandidaten finns i git" "policyns evidence bär candidate_sha '${ROGUE_SHA}' som inte är ett commit i repot"
elif [ "$ROGUE_VERDIKT" != "utanfor_allowed_write" ]; then
  no "K6 avslaget är policyns egen dom" "verdikt '${ROGUE_VERDIKT}', väntade utanfor_allowed_write"
elif "$ATT" "$C_AT" read rogue-1 --require-valid >/dev/null 2>&1; then
  no "K6 attesterades aldrig" "rogue-1 är attesterad trots skrivning utanför allowed_write"
else
  ok "K6 policyavslag mätt på policyns egen evidence: kandidaten finns i git, verdikt utanfor_allowed_write, ingen attestation"
fi

# --- S: seg worker mot kort timeout. Kanarien skrivs EFTER sömnen — finns
# den levde workern förbi timeouten, och då är launch-mekaniken inte i kedjan.
S_AT="$WORK/s-att"; S_ST="$WORK/s-st"; S_LE="$WORK/s-le"; S_WS="$WORK/s-ws"
mkdir -p "$S_WS"; "$ST" init "$S_ST" >/dev/null 2>&1
skriv_config "$WORK/config-s.json" "$WORK/seg-backlog.json" "$S_AT" "$S_ST" "$S_LE" "$S_WS" "$WORK/seg.py" kedja-s 2 check-invariants
"$CLI" run "$WORK/config-s.json" >/dev/null 2>&1; kod_s=$?
if [ ! -f "$WORK/seg-start.txt" ]; then
  no "K13 sessionen startade" "startmarkören saknas — en kanarie som aldrig skrevs bevisar ingen timeout om sessionen aldrig kördes"
elif [ "$kod_s" -eq 0 ] && [ ! -f "$WORK/kanarie.txt" ] \
   && ! "$ATT" "$S_AT" read seg-1 --require-valid >/dev/null 2>&1 \
   && har_status "$S_ST" seg-1 claimed; then
  ok "K13 timeout mäts på effekt: sessionen startade, kanarien skrevs aldrig, ingen attestation"
else
  no "K13 launch-bindning" "exit ${kod_s} (väntat 0), kanarie $([ -f "$WORK/kanarie.txt" ] && echo FINNS || echo saknas) — överlevde workern timeouten är launch inte i kedjan"
fi

# --- V: okänd verifierare. Varvet faller, körningen fortsätter, ingen attest.
V_AT="$WORK/v-att"; V_ST="$WORK/v-st"; V_LE="$WORK/v-le"; V_WS="$WORK/v-ws"
mkdir -p "$V_WS"; "$ST" init "$V_ST" >/dev/null 2>&1
skriv_config "$WORK/config-v.json" "$WORK/verif-backlog.json" "$V_AT" "$V_ST" "$V_LE" "$V_WS" "$WORK/arlig.py" kedja-v 60 finns-inte-i-registret
"$CLI" run "$WORK/config-v.json" >/dev/null 2>&1; kod_v=$?
# KONTROLLKÖRNING: samma backlog och samma fixtur, enda skillnaden är att
# verifieraren är REGISTRERAD. Utan den kan K15 gröna för att varvet dog före
# verifieraren — "ingen attestation" är sant om varvet aldrig kom dit.
V2_AT="$WORK/v2-att"; V2_ST="$WORK/v2-st"; V2_LE="$WORK/v2-le"; V2_WS="$WORK/v2-ws"
mkdir -p "$V2_WS"; "$ST" init "$V2_ST" >/dev/null 2>&1
skriv_config "$WORK/config-v2.json" "$WORK/verif-backlog.json" "$V2_AT" "$V2_ST" "$V2_LE" "$V2_WS" "$WORK/arlig.py" kedja-v2 60 check-invariants
"$CLI" run "$WORK/config-v2.json" >/dev/null 2>&1; kod_v2=$?
if [ "$kod_v" -ne 0 ] || ! har_status "$V_ST" verif-1 claimed \
   || "$ATT" "$V_AT" read verif-1 --require-valid >/dev/null 2>&1; then
  no "K15 verify-bindning" "exit ${kod_v} (väntat 0) — verif-1 attesterades utan körbar verifierare, eller varvet claimade aldrig"
elif [ "$kod_v2" -ne 0 ] || ! "$ATT" "$V2_AT" read verif-1 --require-valid >/dev/null 2>&1; then
  no "K15 kontrollkörningen" "samma fixtur MED registrerad verifierare gav exit ${kod_v2} utan attestation — varvet nådde aldrig verifieraren, så det okända id:t mätte ingenting"
else
  ok "K15 okänd verifierare attesterar aldrig — och samma fixtur med registrerad verifierare attesterar, så varvet nådde verifieraren"
fi

# --- D: upptagen lease.
D_AT="$WORK/d-att"; D_ST="$WORK/d-st"; D_LE="$WORK/d-le"; D_WS="$WORK/d-ws"
mkdir -p "$D_WS"; "$ST" init "$D_ST" >/dev/null 2>&1
"$LE" "$D_LE" acquire kedjan --ttl 300 >/dev/null 2>&1
skriv_config "$WORK/config-d.json" "$WORK/backlog.json" "$D_AT" "$D_ST" "$D_LE" "$D_WS" "$WORK/arlig.py" kedja-d 60 check-invariants
"$CLI" run "$WORK/config-d.json" >/dev/null 2>&1; kod_d=$?
if [ "$kod_d" -ne 0 ] && [ "$(rader "$D_ST")" = "0" ]; then
  ok "K7 upptagen lease vägrar körningen före första varvet, inga event"
else
  no "K7 lease-vägran" "exit ${kod_d} (väntat nollskilt) med $(rader "$D_ST") event (väntat 0) — kedjan körde trots upptagen lease"
fi
"$LE" "$D_LE" release kedjan >/dev/null 2>&1

if [ -z "$("$LE" "$A_LE" owner kedjan 2>/dev/null)" ]; then
  ok "K8 leasen är släppt efter drain"
else
  no "K8 lease-släpp" "lease owner är '$("$LE" "$A_LE" owner kedjan 2>/dev/null)' efter drain (väntat tom)"
fi
fore="$(rader "$A_ST")"
"$CLI" run "$WORK/config-a.json" >/dev/null 2>&1; kod_a2=$?
efter="$(rader "$A_ST")"
if [ "$kod_a2" -eq 0 ] && [ "$fore" = "$efter" ]; then
  ok "K9 redan attesterad backlog ger noll nya event (${fore}→${efter})"
else
  no "K9 tomt drain" "exit ${kod_a2} (väntat 0), event ${fore}→${efter} (väntat oförändrat)"
fi
if [ -z "$(wt_nya)" ]; then
  ok "K10 inga worktree-rester: worktree-listan är den samma som före körningen"
else
  no "K10 rest" "nya worktrees mot läget före körningen: $(wt_nya | tr '\n' ' ') — workspacet rivs inte efter varvet"
fi
if [ "$(git rev-parse HEAD)" = "$BAS" ] && [ "$(git status --porcelain)" = "$FORE_SMUTS" ]; then
  ok "K11 den levande arbetskopian är orörd (HEAD och status oförändrade)"
else
  no "K11 arbetskopian" "HEAD $(git rev-parse HEAD) (väntat ${BAS}) eller smutsstatus ändrad — någon arbetade i den levande kopian"
fi

summera
