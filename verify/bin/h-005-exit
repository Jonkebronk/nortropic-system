#!/usr/bin/env bash
# h-005-exit — skiva 5 (isolerat workspace per försök)
# Kontrakt: controller/workspace/cli create <attempt-id> <base-sha> | path <attempt-id> | destroy <attempt-id>
. "$(dirname "$0")/_lib.sh"
CLI="controller/workspace/cli"
krav_komponent "$CLI"

# Base-SHA skilt från HEAD tvingar fram en verklig utcheckning.
# git -C <underkatalog> rev-parse HEAD besvaras av repot och ger HEAD för
# varje katalog i arbetskopian — en stub hade passerat.
SHA=$(git rev-parse HEAD~1)
"$CLI" destroy t1 >/dev/null 2>&1

# K1: ren checkout på BEORDRAD base-SHA
"$CLI" create t1 "$SHA" >/dev/null 2>&1
WS=$("$CLI" path t1 2>/dev/null)
if [ -n "$WS" ] && [ -d "$WS" ] && [ "$(git -C "$WS" rev-parse HEAD 2>/dev/null)" = "$SHA" ]; then
  ok "K1 workspace på beordrad base-SHA"
else
  no "K1 base-SHA" "workspace saknas eller står på fel SHA"
fi

# K2: workspacet ligger utanför den levande arbetskopians träd.
# pwd -P-olikhet bevisar inget — varje underkatalog skiljer sig från roten.
if [ -z "$WS" ]; then
  no "K2 isolering" "ingen workspace-sökväg"
elif [ "$(cd "$WS" && pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  no "K2 isolering" "workspace ÄR den levande arbetskopian"
elif case "$(cd "$WS" && pwd -P)/" in "$(git rev-parse --show-toplevel)/"*) true;; *) false;; esac; then
  no "K2 isolering" "workspace ligger inuti den levande arbetskopian"
else
  ok "K2 workspace ligger utanför den levande arbetskopians träd"
fi

# K3: workspacet är ett VERKLIGT git-worktree med egen HEAD, inte en katalog
# som råkar ligga i arbetskopian. Prövar inte längre §A-skrivskydd: mätt
# 2026-08-07 att denyWrite nekar hela sökvägsgrenen ovanför sitt mål, så en
# katalog kan inte samtidigt vara skapbar och innehålla skyddade filer.
# §A i workspacet vaktas av skiva 7:s diffpolicy — svagare, och känt svagare.
if [ -z "$WS" ]; then
  no "K3 verkligt worktree" "ingen workspace-sökväg att pröva"
else
  gd=$(git -C "$WS" rev-parse --git-dir 2>/dev/null)
  gcd=$(git -C "$WS" rev-parse --git-common-dir 2>/dev/null)
  topp=$(git -C "$WS" rev-parse --show-toplevel 2>/dev/null)
  egen=$(cd "$WS" && pwd -P)
  if [ -z "$gd" ] || [ -z "$gcd" ]; then
    no "K3 verkligt worktree" "workspace är inte ett git-arbetsträd alls"
  elif [ "$gd" = "$gcd" ]; then
    no "K3 verkligt worktree" "git-dir = common-dir — huvudarbetskopian, inget worktree"
  elif [ "$topp" != "$egen" ]; then
    no "K3 verkligt worktree" "workspace är en underkatalog i ett annat arbetsträd"
  else
    ok "K3 workspace är ett eget git-worktree med egen git-dir"
  fi
fi

# K4: destroy städar helt
"$CLI" destroy t1 >/dev/null 2>&1
if [ -n "$WS" ] && [ -d "$WS" ]; then
  no "K4 städning" "workspace finns kvar efter destroy"
else
  ok "K4 destroy städar workspace"
fi
if [ -n "$WS" ] && git worktree list --porcelain 2>/dev/null | grep -Fqx "worktree $WS"; then
  no "K4b städning" "kvarlämnad worktree efter destroy"
else
  ok "K4b ingen kvarlämnad worktree"
fi
summera
