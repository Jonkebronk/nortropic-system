#!/usr/bin/env bash
# h-005-exit — skiva 5 (isolerat workspace per försök)
# Kontrakt: controller/workspace/cli create <attempt-id> <base-sha> | path <attempt-id> | destroy <attempt-id>
. "$(dirname "$0")/_lib.sh"
CLI="controller/workspace/cli"
krav_komponent "$CLI"

# Base-SHA skilt från HEAD tvingar fram en verklig utcheckning.
# git -C <underkatalog> rev-parse HEAD besvaras av repot och ger HEAD för
# varje katalog i arbetskopian — en stub hade passerat.
SHA=$(git rev-parse HEAD~1)
"$CLI" destroy t1 >/dev/null 2>&1

# K1: ren checkout på BEORDRAD base-SHA
"$CLI" create t1 "$SHA" >/dev/null 2>&1
WS=$("$CLI" path t1 2>/dev/null)
if [ -n "$WS" ] && [ -d "$WS" ] && [ "$(git -C "$WS" rev-parse HEAD 2>/dev/null)" = "$SHA" ]; then
  ok "K1 workspace på beordrad base-SHA"
else
  no "K1 base-SHA" "workspace saknas eller står på fel SHA"
fi

# K2: workspacet ligger utanför den levande arbetskopians träd.
# pwd -P-olikhet bevisar inget — varje underkatalog skiljer sig från roten.
if [ -z "$WS" ]; then
  no "K2 isolering" "ingen workspace-sökväg"
elif [ "$(cd "$WS" && pwd -P)" = "$(git rev-parse --show-toplevel)" ]; then
  no "K2 isolering" "workspace ÄR den levande arbetskopian"
elif case "$(cd "$WS" && pwd -P)/" in "$(git rev-parse --show-toplevel)/"*) true;; *) false;; esac; then
  no "K2 isolering" "workspace ligger inuti den levande arbetskopian"
else
  ok "K2 workspace ligger utanför den levande arbetskopians träd"
fi

# K3: workspacet är ett VERKLIGT git-worktree med egen HEAD, inte en katalog
# som råkar ligga i arbetskopian. Prövar inte längre §A-skrivskydd: mätt
# 2026-08-07 att denyWrite nekar hela sökvägsgrenen ovanför sitt mål, så en
# katalog kan inte samtidigt vara skapbar och innehålla skyddade filer.
# §A i workspacet vaktas av skiva 7:s diffpolicy — svagare, och känt svagare.
if [ -z "$WS" ]; then
  no "K3 verkligt worktree" "ingen workspace-sökväg att pröva"
else
  gd=$(git -C "$WS" rev-parse --git-dir 2>/dev/null)
  gcd=$(git -C "$WS" rev-parse --git-common-dir 2>/dev/null)
  topp=$(git -C "$WS" rev-parse --show-toplevel 2>/dev/null)
  egen=$(cd "$WS" && pwd -P)
  if [ -z "$gd" ] || [ -z "$gcd" ]; then
    no "K3 verkligt worktree" "workspace är inte ett git-arbetsträd alls"
  elif [ "$gd" = "$gcd" ]; then
    no "K3 verkligt worktree" "git-dir = common-dir — huvudarbetskopian, inget worktree"
  elif [ "$topp" != "$egen" ]; then
    no "K3 verkligt worktree" "workspace är en underkatalog i ett annat arbetsträd"
  else
    ok "K3 workspace är ett eget git-worktree med egen git-dir"
  fi
fi

# K4: innehållet är verkligen utcheckat, inte --no-checkout.
# HEAD kan peka rätt på ett tomt träd; "ren checkout" är spec-radens ord.
if [ -z "$WS" ]; then
  no "K4 ren checkout" "ingen workspace-sökväg"
else
  n=$(git -C "$WS" ls-files 2>/dev/null | wc -l | tr -d ' ')
  fys=$(find "$WS" -maxdepth 1 -mindepth 1 ! -name '.git' 2>/dev/null | wc -l | tr -d ' ')
  smuts=$(git -C "$WS" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [ "$n" -lt 100 ] || [ "$fys" -lt 5 ]; then
    no "K4 ren checkout" "trädet är tomt eller nästan tomt: $n indexposter, $fys toppobjekt"
  elif [ "$smuts" != "0" ]; then
    no "K4 ren checkout" "arbetsträdet är smutsigt direkt efter create: $smuts poster"
  else
    ok "K4 ren checkout med verkligt innehåll ($n filer, rent träd)"
  fi
fi

# K5: base-SHA läses per anrop, och två attempts får skilda workspace.
# Provet skickade tidigare ett enda SHA en enda gång — en cli som ignorerar
# argumentet passerade, och "isolerat per försök" var omätt.
SHA2=$(git rev-parse HEAD~2)
"$CLI" destroy t2 >/dev/null 2>&1
"$CLI" create t2 "$SHA2" >/dev/null 2>&1
WS2=$("$CLI" path t2 2>/dev/null)
if [ -z "$WS2" ] || [ ! -d "$WS2" ]; then
  no "K5 per försök" "andra attempt fick inget workspace"
elif [ "$WS2" = "$WS" ]; then
  no "K5 per försök" "två attempts fick SAMMA sökväg — ingen isolering"
elif [ "$(git -C "$WS2" rev-parse HEAD 2>/dev/null)" != "$SHA2" ]; then
  no "K5 per försök" "andra workspace står inte på beordrat SHA — argumentet läses inte"
else
  ok "K5 eget workspace per attempt, base-SHA läses per anrop"
fi

# K6: ogiltigt SHA ger failure, aldrig tyst tom katalog
"$CLI" destroy t3 >/dev/null 2>&1
if "$CLI" create t3 0000000000000000000000000000000000000000 >/dev/null 2>&1; then
  no "K6 ogiltigt SHA" "create lyckades på ett SHA som inte finns"
else
  ok "K6 ogiltigt base-SHA avvisas"
fi

# K7: SIGINT mitt i create → ingen rest. Tredje ledet i exit_criterion,
# tidigare helt oprövat.
"$CLI" destroy t4 >/dev/null 2>&1
gf=$(git branch --list | wc -l | tr -d ' ')
( "$CLI" create t4 "$SHA" >/dev/null 2>&1 ) &
bg=$!
sleep 0.3
kill -INT $bg 2>/dev/null
wait $bg 2>/dev/null
"$CLI" destroy t4 >/dev/null 2>&1
WS4=$("$CLI" path t4 2>/dev/null)
ge=$(git branch --list | wc -l | tr -d ' ')
rest=""
[ -n "$WS4" ] && [ -d "$WS4" ] && rest="$rest workspace-kvar"
git worktree list --porcelain 2>/dev/null | grep -q "t4" && rest="$rest worktree-kvar"
[ "$gf" != "$ge" ] && rest="$rest gren-kvar"
if [ -z "$rest" ]; then
  ok "K7 avbrott mitt i create lämnar ingen rest"
else
  no "K7 avbrottsstädning" "rest efter SIGINT:$rest"
fi

# K8: destroy städar helt — workspace, registrering och gren
grenar_f=$(git branch --list | wc -l | tr -d ' ')
"$CLI" destroy t1 >/dev/null 2>&1
"$CLI" destroy t2 >/dev/null 2>&1
grenar_e=$(git branch --list | wc -l | tr -d ' ')
# Villkoren är INTE [ -n "$WS" ] && ... — en create som failar tyst gjorde
# tidigare städningsproven gröna av frånvaro.
if [ -z "$WS" ]; then
  no "K8 städning" "ingen sökväg att pröva — create gav inget workspace"
elif [ -d "$WS" ]; then
  no "K8 städning" "workspace finns kvar efter destroy"
elif git worktree list --porcelain 2>/dev/null | grep -Fqx "worktree $WS"; then
  no "K8 städning" "kvarlämnad worktree-registrering efter destroy"
elif [ "$grenar_f" != "$grenar_e" ]; then
  no "K8 städning" "grenantalet ändrades av destroy: $grenar_f -> $grenar_e"
else
  ok "K8 destroy städar workspace, registrering och gren"
fi
summera
