    tracked_identities: set[tuple[int, int, str]] = set()
    monitor_stop = threading.Event(); monitor_threads: list[threading.Thread] = []
    original_tracked_popen = module.subprocess.Popen
    def process_table():
        lines = subprocess.run(["/bin/ps", "-axo", "pid=,ppid=,lstart="], text=True,
                               stdout=subprocess.PIPE, check=True).stdout.splitlines()
        rows = {}
        for line in lines:
            parts = line.split()
            if len(parts) >= 7:
                try: rows[int(parts[0])] = (int(parts[1]), " ".join(parts[2:7]))
                except ValueError: pass
        return rows
    def monitor_family(root_pid: int):
        while not monitor_stop.is_set():
            rows = process_table(); family = {root_pid}; changed = True
            while changed:
                changed = False
                for pid, (ppid, started) in rows.items():
                    if ppid in family and pid not in family:
                        family.add(pid); changed = True
            for pid in family:
                if pid in rows: tracked_identities.add((pid, rows[pid][0], rows[pid][1]))
            time.sleep(0.01)
    def tracked_popen(argv, *args, **kwargs):
        process = original_tracked_popen(argv, *args, **kwargs)
        if "-o" in list(argv):
            thread = threading.Thread(target=monitor_family, args=(process.pid,), daemon=True)
            monitor_threads.append(thread); thread.start()
        return process
    module.subprocess.Popen = tracked_popen
