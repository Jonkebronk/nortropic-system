    check("K_NONPROVIDER_GENERIC_EFFECT", generic_effect.rc == 0
          and generic_effect.out == "GENERIC_OK\n"
          and generic_marker.read_text(encoding="utf-8") == "exact-token\n"
          and starts(base) == 0,
          f"rc={generic_effect.rc} out={generic_effect.out!r} marker={generic_marker.exists()} starts={starts(base)}")

    attempt_sequence = [0]
    audit_active: list[dict[str, object] | None] = [None]
    last_attempt_observed: list[dict[str, object] | None] = [None]
    def audit_inventory(event: str, args: tuple[object, ...]) -> None:
        active = audit_active[0]
        if active is None or event not in {"os.mkdir", "open", "os.remove", "os.rename", "subprocess.Popen"}:
            return
        if event == "subprocess.Popen":
            outputs = active["provider_outputs"]
            assert isinstance(outputs, list)
            for value in args:
                if isinstance(value, (list, tuple)) and "-o" in value:
                    outputs.append(str(value[value.index("-o") + 1]))
            return
        created = active["created"]
        assert isinstance(created, set)
        if event == "open":
            opened = active["opened"]
            assert isinstance(opened, list)
            opened.append(tuple(args))
        values = args[1:2] if event == "os.rename" else args[:1]
        for value in values:
            if isinstance(value, (str, bytes, os.PathLike)):
                try:
                    path = Path(value).absolute()
                    if not path.exists(): created.add(str(path))
                except Exception: pass
    sys.addaudithook(audit_inventory)

    def attempt(repo: Path) -> tuple[bool, str, int, int, list[str]]:
        before = starts(repo); cap_before = capture.stat().st_mtime_ns if capture.exists() else -1
        attempt_sequence[0] += 1
        arena = work / f"attempt-tmp-{attempt_sequence[0]}"
        arena.mkdir()
        prior_tmpdir = os.environ.get("TMPDIR")
        prior_tempdir = module.tempfile.tempdir
        os.environ["TMPDIR"] = str(arena)
        module.tempfile.tempdir = str(arena)
        # Seed macOS's exact TMPDIR-local xcrun cache before observation. It is
        # now pre-existing host state, not a basename exception.
        subprocess.run([GIT, "--version"], env=dict(os.environ),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        arena_before = {str(path.absolute()) for path in arena.rglob("*")}
        observed: dict[str, object] = {"created": set(), "opened": [], "provider_outputs": []}
        audit_active[0] = observed
        try:
            try:
                module.run_codex(repo, repo, "TEST_AUTHOR", "H032")
                outcome = (True, "ADMITTED")
            except Exception as exc:
                outcome = (False, f"{type(exc).__name__}:{exc}")
        finally:
            audit_active[0] = None
            module.tempfile.tempdir = prior_tempdir
            if prior_tmpdir is None: os.environ.pop("TMPDIR", None)
            else: os.environ["TMPDIR"] = prior_tmpdir
        cap_after = capture.stat().st_mtime_ns if capture.exists() else -1
        last_attempt_observed[0] = observed
        created = observed["created"]
        assert isinstance(created, set)
        residue_paths = {Path(value) for value in created if Path(value).exists()}
        residue_paths.update(path for path in arena.rglob("*")
                             if str(path.absolute()) not in arena_before)
        expected_runs = module.journal_root(repo) / "runs"
        expected_root_journal = module.journal_root(repo) / "events.jsonl"
        direct_created = sorted(path for path in residue_paths if path.parent == expected_runs)
        exact_run = direct_created[0] if len(direct_created) == 1 else None
        def expected_journal_path(path: Path) -> bool:
            if path == expected_root_journal or path == expected_runs or path == exact_run:
                return True
            return (exact_run is not None and path.parent == exact_run
                    and path.name in {"provider-envelope.json", "events.jsonl", "result.json"})
        residue = sorted(str(path) for path in residue_paths if path != arena
                         and not expected_journal_path(path))
        return outcome[0], outcome[1], starts(repo) - before, int(cap_after != cap_before), residue

