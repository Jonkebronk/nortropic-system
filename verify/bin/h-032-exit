#!/bin/bash -p
# h-032-exit — fresh owner-frozen Codex executable-family identity boundary
#
# Predicted controls before execution:
#   valid locked bytes under an arbitrary basename -> admitted through a private snapshot
#   PATH shadow, relative path, symlink, directory, non-executable and hash drift -> rejected
#   source mutation by the launched fixture -> running image remains the verified snapshot

set -u
umask 077
unset CDPATH ENV BASH_ENV GLOBIGNORE PYTHONHOME PYTHONPATH
export PATH="/usr/bin:/bin:/opt/homebrew/bin"

SOURCE_PATH="${BASH_SOURCE[0]}"
case "$SOURCE_PATH" in
  /*) ;;
  *) SOURCE_PATH="$(/bin/pwd -P)/$SOURCE_PATH" ;;
esac
if [[ -L "$SOURCE_PATH" ]]; then
  echo "ODÖMBART K0 — grindens entry är en symlink"
  exit 2
fi
SCRIPT_DIR="$(cd -P -- "$(/usr/bin/dirname -- "$SOURCE_PATH")" 2>/dev/null && /bin/pwd -P)" || exit 2
ROOT="$(cd -P -- "$SCRIPT_DIR/../.." 2>/dev/null && /bin/pwd -P)" || exit 2
if [[ ! "$SOURCE_PATH" -ef "$ROOT/verify/bin/h-032-exit" ]]; then
  echo "ODÖMBART K0 — icke-kanonisk grindentry"
  exit 2
fi
SOURCE="$ROOT/scripts/nortropic-codex-autopilot.py"
AUTHORITY="$ROOT/config/codex-provider-identity.json"
SCHEMA="$ROOT/docs/loop/codex-autopilot-report.schema.json"
WORK="$(/usr/bin/mktemp -d /private/tmp/nortropic-h032.XXXXXX)" || exit 2
case "$WORK" in /private/tmp/nortropic-h032.*) ;; *) echo "ODÖMBART K0 — osäker tempidentitet"; exit 2;; esac
cleanup() {
  cleanup_rc=$?
  trap - EXIT HUP INT TERM
  case "${WORK:-}" in
    /private/tmp/nortropic-h032.*) /bin/rm -rf -- "$WORK" || cleanup_rc=2 ;;
    *) cleanup_rc=2 ;;
  esac
  exit "$cleanup_rc"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

G20_EMIT=""
if [[ $# -gt 0 ]]; then
  [[ $# -eq 2 && "$1" == "--emit-g20-evidence" ]] || {
    echo "ODÖMBART K0 — användning: h-032-exit [--emit-g20-evidence <path>]"
    exit 2
  }
  G20_EMIT="$2"
fi

/usr/bin/python3 -I -S - "$SOURCE" "$AUTHORITY" "$SCHEMA" "$WORK" "$G20_EMIT" <<'PY'
