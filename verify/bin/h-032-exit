    # GR-07 judge controls: the verdict is attached to the exact opened
    # object's identity. Path metadata alone and omission are insufficient.
    regular_mode = stat.S_IFREG | 0o700; fifo_mode = stat.S_IFIFO | 0o600
    def identity(st): return st.st_dev, st.st_ino
    def opened_regular_oracle(opened_st, inspected_st):
        return (inspected_st is not None and identity(opened_st) == identity(inspected_st)
                and stat.S_ISREG(inspected_st.st_mode))
    gr07_a = jc / "gr07-a"; gr07_b = jc / "gr07-b"
