        f = original_io_open(file, *args, **kwargs)
        mode = args[0] if args else kwargs.get("mode", "r")
        try: same = Path(file) == coherent_cfg
        except TypeError: same = False
        if same and "r" in str(mode) and not authority_swapped[0]:
            os.replace(replacement_cfg, coherent_cfg); authority_swapped[0] = True
        return f
    def authority_builtin_swap(file, *args, **kwargs):
        f = original_builtin_open(file, *args, **kwargs)
        mode = args[0] if args else kwargs.get("mode", "r")
        try: same = Path(file) == coherent_cfg
        except TypeError: same = False
        if same and "r" in str(mode) and not authority_swapped[0]:
            os.replace(replacement_cfg, coherent_cfg); authority_swapped[0] = True
        return f
    def authority_os_swap(file, flags, *args, **kwargs):
        fd = original_os_open(file, flags, *args, **kwargs)
        try: same = Path(file) == coherent_cfg
        except TypeError: same = False
        if same and not (flags & os.O_WRONLY) and not (flags & os.O_RDWR) and not authority_swapped[0]:
            os.replace(replacement_cfg, coherent_cfg); authority_swapped[0] = True
        return fd
