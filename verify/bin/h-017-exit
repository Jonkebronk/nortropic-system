  || [ -n "$(lease_owner "$WORK/exit2-le")" ]; then
  no "K17 ODÖMBART är aldrig PASS eller retrybar FAIL" \
    "exit/start/gate/attest/forbrukat/next-start/next-event/lease=$exit2_rc/$(starter exit2-task)/$exit2_marks/$(attesterad "$WORK/exit2-att" exit2-task && echo ja || echo nej)/$(bryt_field "$WORK/exit2-br/exit2-task" forbrukat)/$(starter zz-after-exit2)/$(event_for "$WORK/exit2-st" zz-after-exit2)/[$(lease_owner "$WORK/exit2-le")]"
else ok "K17 taskgrind 2 stoppar körningen med loop-exit 1 efter exakt ett försök; ingen retry, attest eller claim av nästa task, lease släppt"; fi
vakt_runtime exit2 || { echo; summera; }

# ================= K18: G20, kandidat är data — aldrig domarmiljö ============
write_register base
G20_ALLOWED="controller/verify/**,verify/bin/**,$FIX_REL/**,tests/h017product/**"
write_spec "$WORK/g20-controller.spec.json" \
  "g20-a-controller|$G20_REL|$G20_ALLOWED|"
rigga g20c; CFG_SPEC="$WORK/g20-controller.spec.json"; CFG_BUDGET=1; write_config "$WORK/g20c.config.json"
run_loop "$WORK/g20c.config.json" "$WORK/g20c.out" "$WORK/g20c.err"; g20c_rc=$KOD
vakt_runtime g20-controller || { echo; summera; }

write_spec "$WORK/g20-shadow.spec.json" \
  "g20-b-shadow|$G20_REL|$G20_ALLOWED|"
rigga g20s; CFG_SPEC="$WORK/g20-shadow.spec.json"; CFG_BUDGET=1; write_config "$WORK/g20s.config.json"
run_loop "$WORK/g20s.config.json" "$WORK/g20s.out" "$WORK/g20s.err"; g20s_rc=$KOD
vakt_runtime g20-shadow || { echo; summera; }

write_spec "$WORK/g20-legit.spec.json" \
  "g20-c-legit|$G20_REL|$G20_ALLOWED|"
rigga g20l; CFG_SPEC="$WORK/g20-legit.spec.json"; CFG_BUDGET=1; write_config "$WORK/g20l.config.json"
run_loop "$WORK/g20l.config.json" "$WORK/g20l.out" "$WORK/g20l.err"; g20l_rc=$KOD
vakt_runtime g20-legit || { echo; summera; }

G20_CTRL_SHA="$(find_candidate controller/verify/cli "H017_CANDIDATE_ALWAYS_GREEN_CONTROLLER $TOKEN")"
G20_SHADOW_SHA="$(find_candidate verify/bin/_lib.sh "H017_CANDIDATE_ALWAYS_GREEN_LIB $TOKEN")"
G20_LEGIT_SHA="$(att_sha "$WORK/g20l-att" g20-c-legit)"
g20_ctrl_ok=1
if [ -z "$G20_CTRL_SHA" ]; then
  g20_ctrl_ok=0
else
  git show "$G20_CTRL_SHA:controller/verify/cli" 2>/dev/null | grep -qF "H017_CANDIDATE_ALWAYS_GREEN_CONTROLLER $TOKEN" || g20_ctrl_ok=0
fi
g20_shadow_ok=1
if [ -z "$G20_SHADOW_SHA" ]; then
  g20_shadow_ok=0
else
  git show "$G20_SHADOW_SHA:verify/bin/_lib.sh" 2>/dev/null | grep -qF "H017_CANDIDATE_ALWAYS_GREEN_LIB $TOKEN" || g20_shadow_ok=0
  git show "$G20_SHADOW_SHA:$G20_REL" 2>/dev/null | grep -qF "H017_CANDIDATE_ALWAYS_GREEN_GATE $TOKEN" || g20_shadow_ok=0
  git show "$G20_SHADOW_SHA:$FIX_REL/inner-target.sh" 2>/dev/null | grep -qF "H017_CANDIDATE_ALWAYS_GREEN_INNER $TOKEN" || g20_shadow_ok=0
  git show "$G20_SHADOW_SHA:controller/verify/register.json" 2>/dev/null | grep -qF "H017_CANDIDATE_FRIENDLY_REGISTER $TOKEN" || g20_shadow_ok=0
fi
g20_legit_ok=1
if [ -z "$G20_LEGIT_SHA" ]; then
  g20_legit_ok=0
else
  git show "$G20_LEGIT_SHA:controller/verify/cli" 2>/dev/null | grep -qF 'H017_LEGIT_CONTROL_PLANE_CHANGE' || g20_legit_ok=0
  git show "$G20_LEGIT_SHA:tests/h017product/g20-approved.txt" 2>/dev/null | grep -qF 'legitim kandidatdata' || g20_legit_ok=0
fi
inner_red="$(grep -c '^red ' "$UT/inner-target.log" 2>/dev/null || true)"
inner_green="$(grep -c '^green ' "$UT/inner-target.log" 2>/dev/null || true)"
if [ "$g20c_rc" -ne 0 ] || [ "$g20s_rc" -ne 0 ] || [ "$g20l_rc" -ne 0 ] \
  || [ "$(starter g20-a-controller)" != "1" ] \
  || [ "$(starter g20-b-shadow)" != "1" ] || [ "$(starter g20-c-legit)" != "1" ] \
  || [ "$g20_ctrl_ok" -ne 1 ] || [ "$g20_shadow_ok" -ne 1 ]; then
  no "K18 G20-fixturerna och sabotagecommits är mätbara" \
    "exits/starts/controller-sha/shadow-sha/trees=$g20c_rc,$g20s_rc,$g20l_rc/$(starter g20-a-controller),$(starter g20-b-shadow),$(starter g20-c-legit)/[$G20_CTRL_SHA]/[$G20_SHADOW_SHA]/$g20_ctrl_ok,$g20_shadow_ok"
elif attesterad "$WORK/g20c-att" g20-a-controller \
  || attesterad "$WORK/g20s-att" g20-b-shadow; then
  no "K18 pre-task trusted control plane dömer" "controller- eller skuggkopiekandidaten attesterades"
elif grep -rqF "$G20_CTRL_SHA" "$WORK"/*-att/attestations.json 2>/dev/null \
  || grep -rqF "$G20_SHADOW_SHA" "$WORK"/*-att/attestations.json 2>/dev/null; then
  no "K18 sabotage-SHA finns i ingen attestationsbutik" "controller- eller shadow-SHA återfinns i en attestations.json"
elif [ "$g20_legit_ok" -ne 1 ]; then
  no "K18 legitim trust-critical kandidat kan frias" "positivt syskon saknar attestation eller förväntat kandidatdata/control-plane-diff"
elif [ "$(count_lines "$UT/g20-outer.log")" != "3" ] \
  || [ "$inner_red" != "2" ] || [ "$inner_green" != "1" ]; then
  no "K18 trusted dom skiljer kandidatdata" \
    "trusted outer/red/green=$(count_lines "$UT/g20-outer.log")/$inner_red/$inner_green, väntat 3/2/1"
else ok "K18 G20: controller-sabotage och gröna gate/_lib/register-skuggor attesteras inte; samma trusted grind friar legitim trust-critical kandidatdata"; fi


# ========== K18R runtime — builderbarn får inte skriva trusted runtime =========
#
# K18 binder statiska kandidatskuggor. K18R binder runtimegränsen:
# buildern ska kunna skriva workspace och neutral scratch, även via ett barn
# som skapat en ny process-session, men samma barn får inte skriva controllerns
# pre-task trust-root eller live control plane.
ISO_ROOT="$WORK/runtime-isolation"
ISO_WS="$ISO_ROOT/workspace"
ISO_TRUST="$ISO_ROOT/trust"
ISO_SCRATCH="$ISO_ROOT/scratch"
ISO_KUV="$ISO_ROOT/kuvert.json"
ISO_WORKER="$ISO_ROOT/worker.py"
ISO_RESULT="$ISO_SCRATCH/result.json"

RUNTIME_REPO_PROOF="$ROT/controller/.h017-runtime-$TOKEN"

mkdir -p "$ISO_WS" "$ISO_TRUST" "$ISO_SCRATCH"
printf '{"h017_runtime_probe":true}\n' > "$ISO_KUV"

cat > "$ISO_WORKER" <<'PYWORKER'
from pathlib import Path
import subprocess
import sys

workspace = Path(sys.argv[1])
scratch = Path(sys.argv[2])
trust = Path(sys.argv[3])
repo_probe = Path(sys.argv[4])

(workspace / "parent-inside.txt").write_text(
    "parent\n",
    encoding="utf-8",
)

child_code = r"""
from pathlib import Path
import json
import sys
import time

scratch = Path(sys.argv[1])
trust = Path(sys.argv[2])
repo_probe = Path(sys.argv[3])

time.sleep(0.5)

(scratch / "child-ran.txt").write_text(
    "child\n",
    encoding="utf-8",
)

def attempt(path):
    try:
        Path(path).write_text(
            "SHOULD_NOT_EXIST\n",
            encoding="utf-8",
        )
        return "WROTE"
    except OSError:
        return "DENIED"

result = {
    "trust": attempt(trust / "sentinel.txt"),
    "repo": attempt(repo_probe),
}

(scratch / "result.json").write_text(
    json.dumps(result, sort_keys=True) + "\n",
    encoding="utf-8",
)
"""

sink = (scratch / "child-output.txt").open("ab")

subprocess.Popen(
    [
        sys.executable,
        "-B",
        "-c",
        child_code,
        str(scratch),
        str(trust),
        str(repo_probe),
    ],
    start_new_session=True,
    stdout=sink,
    stderr=sink,
    close_fds=True,
)

sink.close()

print("WORKER_PARENT_EXIT")
PYWORKER

if [ -e "$RUNTIME_REPO_PROOF" ]; then
  no "K18R runtime-fixtur" \
    "repo-sentineln fanns redan före provet: $RUNTIME_REPO_PROOF"
else
  NORTROPIC_TRUST_ROOT="$ISO_TRUST" \
    controller/launch/cli run \
      "$ISO_WS" \
      "$ISO_KUV" \
      20 \
      -- "$PY3" -B "$ISO_WORKER" \
         "$ISO_WS" \
         "$ISO_SCRATCH" \
         "$ISO_TRUST" \
         "$RUNTIME_REPO_PROOF" \
      > "$WORK/runtime-launch.out" \
      2> "$WORK/runtime-launch.err"

  runtime_rc=$?

  i=0
  while [ ! -s "$ISO_RESULT" ] && [ "$i" -lt 60 ]; do
    sleep 0.1
    i=$((i + 1))
  done

  runtime_parent=0
  runtime_child=0
  runtime_trust_status=""
  runtime_repo_status=""
  runtime_trust_exists=0
  runtime_repo_exists=0

  [ -s "$ISO_WS/parent-inside.txt" ] && runtime_parent=1
  [ -s "$ISO_SCRATCH/child-ran.txt" ] && runtime_child=1

  if [ -s "$ISO_RESULT" ]; then
    runtime_fields="$("$PY3" - "$ISO_RESULT" <<'PYRESULT'
import json
import pathlib
import sys

d = json.loads(
    pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
)

print(
    str(d.get("trust", "")) +
    "|" +
    str(d.get("repo", ""))
)
PYRESULT
)"

    runtime_trust_status="${runtime_fields%%|*}"
    runtime_repo_status="${runtime_fields#*|}"
  fi

  [ -e "$ISO_TRUST/sentinel.txt" ] && runtime_trust_exists=1
  [ -e "$RUNTIME_REPO_PROOF" ] && runtime_repo_exists=1

  # Effekten mäts före städning.
  rm -f "$ISO_TRUST/sentinel.txt" "$RUNTIME_REPO_PROOF"

  if [ "$runtime_rc" -ne 0 ]; then
    no "K18R builder-runtimegräns" \
      "launch exit $runtime_rc; stderr: $(head -1 "$WORK/runtime-launch.err" 2>/dev/null)"
  elif [ "$runtime_parent" -ne 1 ]; then
    no "K18R workspace förblir skrivbart" \
      "workerföräldern kunde inte skriva i workspacet"
  elif [ "$runtime_child" -ne 1 ]; then
    no "K18R barnsession + neutral scratch" \
      "barnet i ny process-session lämnade ingen scratchmarkör"
  elif [ "$runtime_trust_status" != "DENIED" ] \
    || [ "$runtime_repo_status" != "DENIED" ] \
    || [ "$runtime_trust_exists" -ne 0 ] \
    || [ "$runtime_repo_exists" -ne 0 ]; then
    no "K18R trusted runtime är skrivskyddad från builderbarn" \
      "trust=$runtime_trust_status/$runtime_trust_exists repo=$runtime_repo_status/$runtime_repo_exists"
  else
    ok "K18R barnsession kan skriva neutral scratch men inte trust-root eller live control plane"
  fi
fi

# ============ K19: byteåterställning + samma traps signalväg =================
if ! restore_register; then
  no "K19 registret återställs byte-identiskt" "inline restore/cmp/förhash misslyckades; backup bevaras av EXIT-trap"
else
  SIGNAL_READY="$WORK/signal.ready"; SIGNAL_OK="$WORK/signal.restored"
  (
    sig_backup="$WORK/register.signal.original"
    sig_sha="$(fil_sha "$REGISTER")"
    cp "$REGISTER" "$sig_backup" || exit 91
    sig_restore() {
      trap - EXIT HUP INT TERM
      if cp "$sig_backup" "$REGISTER" && cmp -s "$sig_backup" "$REGISTER" \
        && [ "$(fil_sha "$REGISTER")" = "$sig_sha" ]; then
        printf 'restored\n' > "$SIGNAL_OK"
      else
        exit 92
      fi
    }
    trap sig_restore EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # Traps ovan är installerade innan den första mutationen.
    printf '{"h017_signal_probe":true}\n' > "$REGISTER"
    printf 'ready\n' > "$SIGNAL_READY"
    while :; do sleep 1; done
  ) &
  signal_pid=$!; OWNED_PIDS="$OWNED_PIDS $signal_pid"
  i=0
  while [ ! -s "$SIGNAL_READY" ] && [ "$i" -lt 200 ]; do sleep 0.02; i=$((i + 1)); done
  if [ -s "$SIGNAL_READY" ]; then kill -TERM "$signal_pid" >/dev/null 2>&1; fi
  wait "$signal_pid" >/dev/null 2>&1; signal_rc=$?
  OWNED_PIDS="${OWNED_PIDS% $signal_pid}"
  if [ "$signal_rc" -ne 143 ] || [ ! -s "$SIGNAL_OK" ] \
    || ! cmp -s "$REGISTER_BACKUP" "$REGISTER" \
    || [ "$(fil_sha "$REGISTER")" != "$REGISTER_SHA_BEFORE" ]; then
    no "K19 registerrestore överlever signal" \
      "signal-exit/mark/cmp/hash=$signal_rc/$([ -s "$SIGNAL_OK" ] && echo ja || echo nej)/$(cmp -s "$REGISTER_BACKUP" "$REGISTER" && echo ja || echo nej)/$(fil_sha "$REGISTER")"
  else ok "K19 registerbackup återställs byte-identiskt på normal väg och TERM-väg; förhashen stämmer"; fi
fi

# ================= K20: slutlig repo/worktree/ref/process-hygien =============
case "$G20_PATH" in "$ROT"/verify/bin/.h017-g20-*) rm -f "$G20_PATH";; esac
case "$FIXROOT" in "$ROT"/tests/controller/loop/.h017-fixture.*) rm -rf "$FIXROOT";; esac
G20_PATH=""; FIXROOT=""

if ! restore_register; then
  no "K20 slutlig registerrestore" "register är inte byte-identiskt; backup bevaras i $REGISTER_BACKUP"
elif [ "$(git rev-parse HEAD)" != "$ROT_HEAD" ]; then
  no "K20 repo/worktree-hygien" "HEAD ändrades"
elif [ "$(git status --porcelain -uall)" != "$ROT_STATUS" ]; then
  no "K20 repo/worktree-hygien" "working tree/staging eller fixturrest avviker från prestate"
elif [ "$(git for-each-ref --format='%(refname) %(objectname)' | LC_ALL=C sort)" != "$ROT_REFS" ]; then
  no "K20 repo/worktree-hygien" "branch/ref-listan avviker från prestate"
elif [ "$(git worktree list --porcelain)" != "$ROT_WORKTREES" ]; then
  no "K20 repo/worktree-hygien" "hela worktree-listan avviker från prestate"
elif [ -n "$(lease_residue)" ]; then
  no "K20 leasehygien" "minst en fixture-lease har kvar en ägare: $(lease_residue)"
elif [ -n "$OWNED_PIDS" ]; then
  no "K20 processhygien" "ägda pid-listan är inte tom: $OWNED_PIDS"
elif echo " $CHAIN_KODER " | grep -q ' 123 '; then
  no "K20 processhygien" "minst en loop lämnade processgruppsbarn (koder:$CHAIN_KODER)"
elif echo " $CHAIN_KODER " | grep -q ' 2 '; then
  no "K20 exit 2 användes som kedjedom" "loopkoder:$CHAIN_KODER"
else ok "K20 register, HEAD, staging, rotstatus, alla refs och hela worktree-listan byte-/textlika; inga ägda processer, ingen loopdom 2"; fi

summera
