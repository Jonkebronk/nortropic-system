#!/usr/bin/env bash
# h-017-exit — skiva 15 (trusted per-task-dom före produktionsimplementation)
#
# Provet binder EFFEKT, inte ett framtida internt verb:
#   spec.task.exit_test --exakt path--> trusted registerpost --> trusted grind
#   global verifier PASS OCH taskgrind PASS --> attestation med grind_id + SHA
#   säker oregistrerad path --> attestation utan båda grindfälten
#   taskgrind FAIL --> retrybar dom; taskgrind 2/refusal --> riggfel, aldrig dom
#
# G20 binds med ett par: en kandidat ersätter controller/verify/cli; en annan
# lägger alltid-gröna skuggor av register, taskgrind och _lib.sh. Den TRUSTED taskgrinden
# anropar controller/verify/cli relativt. Om kandidatens cwd fortfarande är
# domarens exekveringsmiljö blir domen grön; med pre-task control plane blir den
# röda trusted innergrinden bestämmande. Kandidatcommiten måste samtidigt finnas
# i git med sabotaget men saknas i attestbutiken.
#
# MUTANTPREDIKTION (skriven före körning):
#   M01 ingen taskgrind                    -> K4/K5
#   M02 grind mot reporot/fel workspace    -> K4
#   M03 kandidatens control plane används  -> K18
#   M04 friendly id vinner                 -> K4/K7
#   M05 noll träff blir påhittad dom        -> K6
#   M06 dubbla paths väljs                 -> K7
#   M07 global verifier ersätts             -> K5
#   M08 taskgrind ignoreras                 -> K4/K5
#   M09 röd grind kostar inte budget        -> K4
#   M10 dömd attest saknar identitet        -> K6
#   M11 ogrindad attest är halv/tvetydig    -> K6
#   M12 registerrigg bränner session        -> K9–K13
#   M13 exit 2 blir PASS                    -> K3/K17
#   M14 exit 2 blir retrybar FAIL           -> K17
#   M15 exit_test körs av shell             -> K8
#   M16 bashrunner är inert                 -> K1
#   M17 fel register-SHA accepteras         -> K9
#   M18 taskgrindsteget är oskiljbart       -> K5
#   M19 repo/ref/worktree lämnas ändrat      -> varje vakt + K20
#   M20 registerrestore misslyckas tyst      -> K19/K20
#
# Alla loopkörningar har en processgruppsfrist. Räknare ligger utanför varje
# workspace. Det verkliga registret muteras bara efter bytebackup och efter att
# en idempotent EXIT/HUP/INT/TERM-trap installerats; backupen tas bort först
# efter bytejämförelse och förhashkontroll.
. "$(dirname "$0")/_lib.sh"

LOOP="controller/loop/cli"
VERIFY="controller/verify/cli"
ATT="controller/attest/cli"
ST="controller/state/cli"
LE="controller/lease/cli"
BR="controller/brytare/cli"
WSP="controller/workspace/cli"
REGISTER="controller/verify/register.json"

krav_komponent "$LOOP"
for dep in "$VERIFY" "$ATT" "$ST" "$LE" "$BR" "$WSP" \
  controller/taskval/cli controller/envelope/cli controller/worker/cli \
  controller/policy/cli controller/utforare/cli controller/launch/cli; do
  if [ ! -x "$dep" ]; then
    echo "FAIL  K0 harness — $dep saknas eller är inte körbar"
    echo; echo "$pass PASS, $((fail + 1)) FAIL"; exit 1
  fi
done

PY3="$(command -v python3)"
if [ -z "$PY3" ]; then
  echo "FAIL  K0 harness — python3 saknas"
  echo; echo "$pass PASS, $((fail + 1)) FAIL"; exit 1
fi

ROT="$(git rev-parse --show-toplevel)"
WORK="$(temp_kat)" || {
  echo "FAIL  K0 harness — temp-katalog kunde inte skapas"
  echo; echo "$pass PASS, $((fail + 1)) FAIL"; exit 1
}
WORK="$(cd "$WORK" && pwd -P)"
UT="$WORK/ut"; mkdir -p "$UT"
export H017_UT="$UT"
LEASE_DIR_LOG="$WORK/lease-dirs"
: > "$LEASE_DIR_LOG"

FIXROOT=""
G20_PATH=""
REGISTER_BACKUP="$WORK/register.original"
REGISTER_SHA_BEFORE=""
REGISTER_EXPECTED_SHA=""
REGISTER_ARMED=0
CLEANING=0
OWNED_PIDS=""
ROT_HEAD="$(git rev-parse HEAD)"
ROT_STATUS="$(git status --porcelain -uall)"
ROT_REFS="$(git for-each-ref --format='%(refname) %(objectname)' | LC_ALL=C sort)"
ROT_WORKTREES="$(git worktree list --porcelain)"

fil_sha() {
  "$PY3" - "$1" <<'PY'
import hashlib, pathlib, sys
print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())
PY
}

cleanup_owned_worktrees() {
  git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' |
  while IFS= read -r ws; do
    case "$ws" in
      "$WORK"/*)
        rot="$(dirname "$ws")"; attempt="$(basename "$ws")"
        "$WSP" "$rot" destroy "$attempt" >/dev/null 2>&1 || true
        ;;
    esac
  done
}

restore_register() {
  [ -f "$REGISTER_BACKUP" ] || return 1
  cp "$REGISTER_BACKUP" "$REGISTER" 2>/dev/null || return 1
  cmp -s "$REGISTER_BACKUP" "$REGISTER" || return 1
  [ "$(fil_sha "$REGISTER" 2>/dev/null)" = "$REGISTER_SHA_BEFORE" ] || return 1
}

cleanup() {
  rc=$?
  [ "$CLEANING" -eq 0 ] || exit "$rc"
  CLEANING=1
  trap - EXIT HUP INT TERM
  for pid in $OWNED_PIDS; do
    kill -TERM "$pid" >/dev/null 2>&1 || true
    wait "$pid" >/dev/null 2>&1 || true
  done
  cleanup_owned_worktrees
  register_restore_ok=1
  worktree_restore_ok=1
  if [ "$REGISTER_ARMED" -eq 1 ]; then
    restore_register || register_restore_ok=0
  fi
  case "$G20_PATH" in
    "$ROT"/verify/bin/.h017-g20-*) rm -f "$G20_PATH" ;;
  esac
  case "${RUNTIME_REPO_PROOF:-}" in
    "$ROT"/controller/.h017-runtime-*) rm -f "$RUNTIME_REPO_PROOF" ;;
  esac
  case "$FIXROOT" in
    "$ROT"/tests/controller/loop/.h017-fixture.*) rm -rf "$FIXROOT" ;;
  esac
  if [ "$(git worktree list --porcelain)" != "$ROT_WORKTREES" ]; then
    echo "FAIL  K20 worktreerestore — worktree-listan kunde inte återställas; $WORK bevaras" >&2
    worktree_restore_ok=0
  fi
  if [ "$register_restore_ok" -eq 1 ] && [ "$worktree_restore_ok" -eq 1 ]; then
    rm -rf "$WORK"
  else
    if [ "$register_restore_ok" -ne 1 ]; then
      echo "FAIL  K19 registerrestore — återställning misslyckades; backup BEVARAD i $REGISTER_BACKUP" >&2
    fi
    rc=1
  fi
  exit "$rc"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

cp "$REGISTER" "$REGISTER_BACKUP" || {
  echo "FAIL  K0 harness — registret kunde inte bytekopieras"
  echo; echo "$pass PASS, $((fail + 1)) FAIL"; exit 1
}
REGISTER_SHA_BEFORE="$(fil_sha "$REGISTER")"

FIXROOT="$(mktemp -d "$ROT/tests/controller/loop/.h017-fixture.XXXXXX")" || {
  echo "FAIL  K0 harness — repo-intern fixturkatalog kunde inte skapas"
  echo; echo "$pass PASS, $((fail + 1)) FAIL"; exit 1
}
FIXROOT="$(cd "$FIXROOT" && pwd -P)"
FIX_REL="${FIXROOT#"$ROT"/}"
TOKEN="$(basename "$FIXROOT" | tr -cd 'A-Za-z0-9')"
CORRECT_ID="pathdom-${TOKEN}"
FRIENDLY_ID="c-friendly-green"
INNER_ID="trusted-inner-${TOKEN}"
EXIT2_ID="unjudgeable-${TOKEN}"
DRIFT_ID="drift-${TOKEN}"
G20_ID="g20-${TOKEN}"
UNKNOWN_ID="unknown-runner-${TOKEN}"
NONSTART_ID="nonstart-${TOKEN}"
G20_REL="$FIX_REL/g20.sh"
G20_PATH="$ROT/$G20_REL"
export H017_FIX_REL="$FIX_REL" H017_G20_REL="$G20_REL" H017_TOKEN="$TOKEN" H017_INNER_ID="$INNER_ID"

cat > "$FIXROOT/candidate.sh" <<'SH'
#!/usr/bin/env bash
if [ -e tests/h017product/required.txt ]; then
  printf 'green %s\n' "$PWD" >> "$H017_UT/candidate-gate.log"
  exit 0
fi
printf 'red %s\n' "$PWD" >> "$H017_UT/candidate-gate.log"
exit 1
SH
cat > "$FIXROOT/friendly.sh" <<'SH'
#!/usr/bin/env bash
printf 'friendly %s\n' "$PWD" >> "$H017_UT/friendly-gate.log"
exit 0
SH
cat > "$FIXROOT/inner-target.sh" <<'SH'
#!/usr/bin/env bash
if [ -e tests/h017product/g20-approved.txt ]; then
  printf 'green %s\n' "$PWD" >> "$H017_UT/inner-target.log"
  exit 0
fi
printf 'red %s\n' "$PWD" >> "$H017_UT/inner-target.log"
exit 1
SH
cat > "$FIXROOT/exit2.sh" <<'SH'
#!/usr/bin/env bash
printf 'unjudgeable %s\n' "$PWD" >> "$H017_UT/exit2-gate.log"
exit 2
SH
cat > "$FIXROOT/drift.sh" <<'SH'
#!/usr/bin/env bash
printf 'DRIFTED_GATE_EXECUTED %s\n' "$PWD" >> "$H017_UT/drift-gate.log"
exit 0
SH
cat > "$FIXROOT/unknown.sh" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat > "$FIXROOT/nonstart.sh" <<'SH'
#!/usr/bin/env bash
exit 0
SH
ln -s candidate.sh "$FIXROOT/unsafe-link"
chmod +x "$FIXROOT"/*.sh
cp "$FIXROOT/drift.sh" "$WORK/drift.original"

cat > "$G20_PATH" <<SH
#!/usr/bin/env bash
. "$ROT/verify/bin/_lib.sh"
krav_komponent "controller/verify/cli"
printf 'trusted-outer %s\\n' "\$PWD" >> "\$H017_UT/g20-outer.log"
controller/verify/cli run "$INNER_ID" "\$PWD"
SH
chmod +x "$G20_PATH"

cat > "$WORK/session.py" <<'PY'
import hashlib, json, os, pathlib, sys, time

task = json.load(sys.stdin)["task_id"]
ut = pathlib.Path(os.environ["H017_UT"])
token = os.environ["H017_TOKEN"]
counter = ut / ("starter-" + task)
with counter.open("a") as f:
    f.write("start\n")

def write(path, text, executable=False):
    p = pathlib.Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text, encoding="utf-8")
    if executable:
        p.chmod(0o755)

if task == "a-policy-red":
    write("tests/h017-outside.txt", "utanför taskens yta\n")
elif task == "b-global-red":
    write("agents/h017-global-red.md",
          "---\nname: h017-global-red\ntools: Bash\n---\n\n"
          "Äkta INV-004-fixtur utan EXTERN DATA-blocket. " + token + "\n")
elif task == "c-friendly-green":
    write("tests/h017product/wrong.txt", "fel effekt " + token + "\n")
elif task == "d-target-good":
    write("tests/h017product/required.txt", "rätt effekt\n")
elif task == "e-ungated":
    write("tests/h017product/ungated.txt", "säker men oregistrerad grind\n")
elif task == "a-drift-anchor":
    write("tests/h017product/drift-anchor.txt", "första tasken\n")
    time.sleep(2)
elif task == "b-drift-target":
    write("tests/h017product/drift-target.txt", "får aldrig starta\n")
elif task == "g20-a-controller":
    token = os.environ["H017_TOKEN"]
    write("controller/verify/cli",
          "#!/bin/sh\n# H017_CANDIDATE_ALWAYS_GREEN_CONTROLLER %s\nexit 0\n" % token, True)
elif task == "g20-b-shadow":
    fix = os.environ["H017_FIX_REL"]
    g20 = os.environ["H017_G20_REL"]
    token = os.environ["H017_TOKEN"]
    inner = fix + "/inner-target.sh"
    write(inner,
          "#!/bin/sh\n# H017_CANDIDATE_ALWAYS_GREEN_INNER %s\nexit 0\n" % token, True)
    inner_sha = hashlib.sha256(pathlib.Path(inner).read_bytes()).hexdigest()
    write("controller/verify/register.json",
          json.dumps({"register_version": "1.0.0", "verifiers": {
              os.environ.get("H017_INNER_ID", "inner"): {
                  "path": inner, "sha256": inner_sha, "runner": "bash",
                  "startbar": True, "beskrivning": "H017_CANDIDATE_FRIENDLY_REGISTER " + token
              }}}) + "\n")
    write("verify/bin/_lib.sh",
          "# H017_CANDIDATE_ALWAYS_GREEN_LIB %s\n" % token +
          "pass=0; fail=0\nok(){ :; }\nno(){ :; }\n"
          "krav_komponent(){ :; }\nsummera(){ exit 0; }\n")
    write(g20, "#!/bin/sh\n# H017_CANDIDATE_ALWAYS_GREEN_GATE %s\nexit 0\n" % token, True)
elif task == "g20-c-legit":
    # Positivt G20-syskon: trust-critical diff får inte avvisas kategoriskt.
    # Kandidatens control-plane-version är medvetet obrukbar som domare, medan
    # kandidatDATAN uppfyller samma trusted innergrind som sabotaget faller på.
    write("controller/verify/cli",
          "#!/bin/sh\n# H017_LEGIT_CONTROL_PLANE_CHANGE\nexit 7\n", True)
    write("tests/h017product/g20-approved.txt", "legitim kandidatdata\n")
else:
    write("tests/h017product/" + task + ".txt", "fixtur\n")

print("redigerade " + task)
PY

write_register() { # write_register <base|duplicate|sha|missing|outside|symlink|structure|unknown|nonstart>
  "$PY3" - "$ROT" "$REGISTER" "$REGISTER_BACKUP" "$FIX_REL" "$G20_REL" "$1" \
    "$CORRECT_ID" "$FRIENDLY_ID" "$INNER_ID" "$EXIT2_ID" "$DRIFT_ID" \
    "$G20_ID" "$UNKNOWN_ID" "$NONSTART_ID" <<'PY'
import hashlib, json, pathlib, sys
root, out, backup, fix, g20, mode, correct, friendly, inner, exit2, drift, g20id, unknown, nonstart = sys.argv[1:]
root = pathlib.Path(root)

def digest(path):
    p = pathlib.Path(path)
    if not p.is_absolute():
        p = root / p
    return hashlib.sha256(p.read_bytes()).hexdigest()

def post(path, runner="bash", start=True, sha=None):
    p = {"path": path, "sha256": sha if sha is not None else digest(path),
         "runner": runner, "startbar": start, "beskrivning": "h-017-fixtur"}
    if not start:
        p["skal_ej_startbar"] = "h-017-fixtur saknar subprocess-ingång"
    return p

if mode == "structure":
    pathlib.Path(out).write_text('{"register_version":"h017","verifiers":[]}\n', encoding="utf-8")
    raise SystemExit

v = {
    "check-invariants": post("scripts/check-invariants.mjs", "node", True),
    correct: post(fix + "/candidate.sh"),
    friendly: post(fix + "/friendly.sh"),
    inner: post(fix + "/inner-target.sh"),
    exit2: post(fix + "/exit2.sh"),
    drift: post(fix + "/drift.sh"),
    g20id: post(g20),
    "fixture-nonstart-unselected": post("workflows/nortropic-verify-suite.js", None, False),
}
if mode == "duplicate":
    v["duplicate-" + correct] = post(fix + "/candidate.sh")
elif mode == "sha":
    # OVALD och icke-startbar: hela registret måste ändå hashvalideras.
    v["rig-sha"] = post(fix + "/unknown.sh", None, False, sha="0" * 64)
elif mode == "missing":
    v["rig-missing"] = post(fix + "/does-not-exist.sh", sha="1" * 64)
elif mode == "outside":
    v["rig-outside"] = post("/bin/sh")
elif mode == "symlink":
    v["rig-symlink"] = post(fix + "/unsafe-link")
elif mode == "unknown":
    v[unknown] = post(fix + "/unknown.sh", "h017-runner-saknas", True)
elif mode == "nonstart":
    v[nonstart] = post(fix + "/nonstart.sh", "bash", False)

data = json.loads(pathlib.Path(backup).read_text(encoding="utf-8"))
data["verifiers"] = v
pathlib.Path(out).write_text(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
                             encoding="utf-8")
PY
  REGISTER_EXPECTED_SHA="$(fil_sha "$REGISTER")"
}

write_spec() { # write_spec <fil> 'id|exit_path|allowed,allowed|dependency' ...
  fil="$1"; shift
  "$PY3" - "$fil" "$@" <<'PY'
import json, pathlib, sys
tasks = []
for raw in sys.argv[2:]:
    tid, gate, allowed, dep = raw.split("|", 3)
    tasks.append({"id": tid, "slice": 0, "title": tid, "summary": "h-017-fixtur",
                  "allowed_write": [x for x in allowed.split(",") if x],
                  "exit_test": gate, "exit_criterion": "fixtur",
                  "docs_impact": [], "depends_on": [dep] if dep else []})
data = {"spec_version": "h017-fixtur",
        "defaults": {"max_changed_files": 12, "max_added_lines": 1000},
        "tasks": tasks}
pathlib.Path(sys.argv[1]).write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n",
                                    encoding="utf-8")
PY
}

rigga() { # rigga <namn>
  CFG_NAME="$1"
  CFG_AT="$WORK/$1-att"; CFG_ST="$WORK/$1-st"; CFG_LE="$WORK/$1-le"
  CFG_WS="$WORK/$1-ws"; CFG_BR="$WORK/$1-br"; CFG_RUN="k17$1"
  CFG_BUDGET=1; CFG_TROSKEL=9; CFG_TO=30; CFG_VER="check-invariants"
  printf '%s\n' "$CFG_LE" >> "$LEASE_DIR_LOG"
  mkdir -p "$CFG_WS"
  "$ST" init "$CFG_ST" >/dev/null 2>&1
}

write_config() {
  cat > "$1" <<JSON
{ "spec": "$CFG_SPEC", "attest_dir": "$CFG_AT", "state_dir": "$CFG_ST",
  "lease_dir": "$CFG_LE", "lease_resurs": "h017", "workspace_rot": "$CFG_WS",
  "base_sha": "$ROT_HEAD", "worker_cmd": ["$PY3", "$WORK/session.py"],
  "timeout_s": $CFG_TO, "verifier_id": "$CFG_VER", "run_id": "$CFG_RUN",
  "brytare_rot": "$CFG_BR", "budget": $CFG_BUDGET, "troskel": $CFG_TROSKEL }
JSON
}

run_loop() { # run_loop <config> <stdout> <stderr> [timeout]
  "$PY3" - "$LOOP" "$1" "$2" "$3" "${4:-90}" <<'PY'
import os, signal, subprocess, sys, time
cli, config, out, err, timeout = sys.argv[1:]

def group_alive(pid):
    try:
        os.killpg(pid, 0)
        return True
    except ProcessLookupError:
        return False

def signal_group(pid, sig):
    try:
        os.killpg(pid, sig)
    except ProcessLookupError:
        pass

def wait_group_gone(pid, seconds):
    deadline = time.monotonic() + seconds
    while group_alive(pid) and time.monotonic() < deadline:
        time.sleep(0.02)

with open(out, "wb") as stdout, open(err, "wb") as stderr:
    p = subprocess.Popen([cli, "run", config], stdout=stdout, stderr=stderr,
                         start_new_session=True)
    time.sleep(0.05)
    try:
        rc = p.wait(timeout=float(timeout))
    except subprocess.TimeoutExpired:
        signal_group(p.pid, signal.SIGTERM)
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            signal_group(p.pid, signal.SIGKILL)
            p.wait()
        # Ledaren kan ha dött av TERM medan ett gruppbarn ignorerade signalen.
        # Timeoutsvägen måste därför alltid pröva hela gruppen en gång till.
        if group_alive(p.pid):
            signal_group(p.pid, signal.SIGKILL)
            wait_group_gone(p.pid, 1)
        raise SystemExit(124)
    # Leadern får inte lämna barn i sin processgrupp. En sådan rest dödas för
    # säkerhet men klassas 123, så städningen aldrig kan göra mutanten grön.
    if group_alive(p.pid):
        stderr.write(b"harness: process residue after loop leader exited\n")
        signal_group(p.pid, signal.SIGTERM)
        time.sleep(0.2)
        if group_alive(p.pid):
            signal_group(p.pid, signal.SIGKILL)
            wait_group_gone(p.pid, 1)
        rc = 123
raise SystemExit(rc if rc >= 0 else 128 - rc)
PY
  KOD=$?
  CHAIN_KODER="$CHAIN_KODER $KOD"
}

attesterad() { "$ATT" "$1" read "$2" --require-valid >/dev/null 2>&1; }
att_sha() {
  "$ATT" "$1" read "$2" --require-valid 2>/dev/null |
    "$PY3" -c 'import json,sys; print(json.load(sys.stdin).get("candidate_sha", ""))' 2>/dev/null
}
att_field() {
  "$ATT" "$1" read "$2" --require-valid 2>/dev/null |
    "$PY3" -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1], ""))' "$3" 2>/dev/null
}
att_has_field() {
  "$ATT" "$1" read "$2" --require-valid 2>/dev/null |
    "$PY3" -c 'import json,sys; d=json.load(sys.stdin); raise SystemExit(0 if sys.argv[1] in d else 1)' "$3" 2>/dev/null
}
starter() { [ -f "$UT/starter-$1" ] && wc -l < "$UT/starter-$1" | tr -d ' ' || echo 0; }
count_lines() { [ -f "$1" ] && wc -l < "$1" | tr -d ' ' || echo 0; }
event_rows() { [ -f "$1/events.jsonl" ] && wc -l < "$1/events.jsonl" | tr -d ' ' || echo 0; }
event_for() {
  "$PY3" - "$1/events.jsonl" "$2" <<'PY' 2>/dev/null || echo PYFEL
import json, pathlib, sys
p = pathlib.Path(sys.argv[1]); n = 0
if p.exists():
    for line in p.read_text(encoding="utf-8").splitlines():
        try: d = json.loads(line)
        except ValueError: continue
        n += d.get("task") == sys.argv[2]
print(n)
PY
}
bryt_field() {
  "$BR" status "$1" 2>/dev/null | "$PY3" -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: print(""); raise SystemExit
print(d.get(sys.argv[1], ""))' "$2" 2>/dev/null
}
lease_owner() { "$LE" "$1" owner h017 2>/dev/null; }
lease_residue() {
  while IFS= read -r lease_dir; do
    owner="$(lease_owner "$lease_dir")"
    [ -z "$owner" ] || printf '%s=%s\n' "$lease_dir" "$owner"
  done < "$LEASE_DIR_LOG"
}
status_is() {
  "$ST" rebuild "$1" 2>/dev/null | "$PY3" -c 'import json,sys
try: rows=json.load(sys.stdin)
except Exception: raise SystemExit(1)
d={row.get("task"):row.get("status") for row in rows}
raise SystemExit(0 if d.get(sys.argv[1]) == sys.argv[2] else 1)' "$2" "$3"
}

find_candidate() { # find_candidate <path> <fixed marker>
  path="$1"; marker="$2"
  git fsck --unreachable --no-reflogs --no-progress 2>/dev/null |
    awk '$2 == "commit" {print $3}' |
    while IFS= read -r sha; do
      if git show "$sha:$path" 2>/dev/null | grep -qF "$marker"; then
        echo "$sha"; break
      fi
    done
}

run_verify_commit() { # run_verify_commit <sha> <attempt> <stdout> <stderr>
  probe_root="$WORK/probe-$2"
  mkdir -p "$probe_root"
  if ! "$WSP" "$probe_root" create "$2" "$1" > "$WORK/$2.path" 2> "$WORK/$2-create.err"; then
    PROBE_CODE=125
    return 0
  fi
  probe_ws="$(cat "$WORK/$2.path")"
  "$VERIFY" run check-invariants "$probe_ws" > "$3" 2> "$4"; PROBE_CODE=$?
  "$WSP" "$probe_root" destroy "$2" >/dev/null 2>&1 || PROBE_CODE=126
}

filtered_status() {
  git status --porcelain -uall | while IFS= read -r line; do
    path="${line#???}"
    case "$path" in
      "$REGISTER"|"$FIX_REL"/*|"$G20_REL") ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
}

vakt_runtime() {
  label="$1"
  if [ "$(git rev-parse HEAD)" != "$ROT_HEAD" ]; then
    no "hygien efter $label" "HEAD ändrades"; return 1
  fi
  if [ "$(git for-each-ref --format='%(refname) %(objectname)' | LC_ALL=C sort)" != "$ROT_REFS" ]; then
    no "hygien efter $label" "refs/brancher ändrades"; return 1
  fi
  if [ "$(git worktree list --porcelain)" != "$ROT_WORKTREES" ]; then
    no "hygien efter $label" "hela worktree-listan avviker"; return 1
  fi
  if [ "$(filtered_status)" != "$ROT_STATUS" ]; then
    no "hygien efter $label" "annan rotstatus än register + egna fixturer tillkom"; return 1
  fi
  if [ -z "$REGISTER_EXPECTED_SHA" ] || [ "$(fil_sha "$REGISTER")" != "$REGISTER_EXPECTED_SHA" ]; then
    no "hygien efter $label" "controller muterade den installerade registerfixturens bytes"; return 1
  fi
  leaked_lease="$(lease_residue)"
  if [ -n "$leaked_lease" ]; then
    no "hygien efter $label" "fixture-lease har kvar ägare: $leaked_lease"; return 1
  fi
  return 0
}

stegord() {
  grep "varv [0-9][0-9]* $2: avbrutet i " "$1" 2>/dev/null | head -1 |
    sed -n 's/^.*avbrutet i \([^ ]*\).*$/\1/p'
}

