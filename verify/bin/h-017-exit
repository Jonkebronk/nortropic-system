import re, pathlib, sys
s = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
m = re.findall(r"(?<![0-9a-f])[0-9a-f]{64}(?![0-9a-f])", s, re.I)
print(m[0].lower() if len(set(x.lower() for x in m)) == 1 else "")
PY
)"
