# ============== K9–K13: hela registret före lease/session ==================
preflight_case() { # preflight_case <name> <register-mode> <rubrik>
  n="$1"; mode="$2"; title="$3"
  write_register "$mode"
  refusal_ok=1; refusal_code="-"
  if [ "$mode" = "sha" ]; then
    "$VERIFY" check rig-sha > "$WORK/$n-check.out" 2> "$WORK/$n-check.err"; refusal_code=$?
    DIRECT_KODER="$DIRECT_KODER $refusal_code"
    if [ "$refusal_code" -eq 0 ] || [ "$refusal_code" -eq 1 ] || [ "$refusal_code" -eq 2 ]; then
      refusal_ok=0
    fi
  fi
  spec="$WORK/$n.spec.json"
  write_spec "$spec" "$n-task|verify/bin/h017-safe-unregistered-$TOKEN|tests/h017product/**|"
  rigga "$n"; CFG_SPEC="$spec"; write_config "$WORK/$n.config.json"
  run_loop "$WORK/$n.config.json" "$WORK/$n.out" "$WORK/$n.err"; rc=$KOD
  if [ "$rc" -ne 1 ] || [ "$(starter "$n-task")" != "0" ] \
    || [ "$(event_rows "$WORK/$n-st")" != "0" ] || [ -e "$WORK/$n-le" ] \
    || [ -e "$WORK/$n-br" ] || attesterad "$WORK/$n-att" "$n-task" \
    || [ "$refusal_ok" -ne 1 ] || grep -qi 'traceback' "$WORK/$n.out" "$WORK/$n.err"; then
    no "$title" \
      "exit/start/event/lease-dir/brytare/attest/refusal=$rc/$(starter "$n-task")/$(event_rows "$WORK/$n-st")/$([ -e "$WORK/$n-le" ] && echo ja || echo nej)/$([ -e "$WORK/$n-br" ] && echo ja || echo nej)/$(attesterad "$WORK/$n-att" "$n-task" && echo ja || echo nej)/$refusal_code"
  else ok "$title"; fi
  vakt_runtime "$n" || { echo; summera; }
}

preflight_case pfsha sha "K9 driven register-SHA stoppas före lease, event, brytare och session"
preflight_case pfmissing missing "K10 saknad registrerad fil stoppas före lease, event, brytare och session"
preflight_case pfoutside outside "K11 path utanför repot stoppas före lease, event, brytare och session"
preflight_case pfsymlink symlink "K12 osäker symlinkpath stoppas före lease, event, brytare och session"
preflight_case pfstructure structure "K13 ogiltig registerstruktur klassas utan traceback eller kvot"

# =========== K14: vald okänd/icke-startbar post före taskens session =========
selected_refusal() { # selected_refusal <name> <mode> <id> <path> <rubrik>
  n="$1"; mode="$2"; id="$3"; path="$4"; title="$5"
  write_register "$mode"
  spec="$WORK/$n.spec.json"
  write_spec "$spec" "$n-task|$path|tests/h017product/**|"
  rigga "$n"; CFG_SPEC="$spec"; CFG_BUDGET=3; write_config "$WORK/$n.config.json"
  run_loop "$WORK/$n.config.json" "$WORK/$n.out" "$WORK/$n.err"; rc=$KOD
  "$VERIFY" run "$id" "$WORK/direct-red" >"$WORK/$n-direct.out" 2>"$WORK/$n-direct.err"; direct=$?
  DIRECT_KODER="$DIRECT_KODER $direct"
  if [ "$rc" -ne 1 ] || [ "$(starter "$n-task")" != "0" ] \
    || attesterad "$WORK/$n-att" "$n-task" || [ -e "$WORK/$n-br/$n-task" ] \
    || [ -n "$(lease_owner "$WORK/$n-le")" ] \
    || [ "$direct" -eq 0 ] || [ "$direct" -eq 1 ] || [ "$direct" -eq 2 ]; then
    no "$title" \
      "loop/direct/start/attest/brytare=$rc/$direct/$(starter "$n-task")/$(attesterad "$WORK/$n-att" "$n-task" && echo ja || echo nej)/$([ -e "$WORK/$n-br/$n-task" ] && echo ja || echo nej)"
  else ok "$title"; fi
  vakt_runtime "$n" || { echo; summera; }
}

selected_refusal pfunknown unknown "$UNKNOWN_ID" "$FIX_REL/unknown.sh" \
  "K14 vald okänd runner vägras utan session/retry och med egen refusal-kod"
selected_refusal pfnonstart nonstart "$NONSTART_ID" "$FIX_REL/nonstart.sh" \
  "K14 vald icke-startbar post vägras utan session/retry och med egen refusal-kod"

