  printf 'klar\n' > "$UT/drift-mutated"
) &
watcher=$!; OWNED_PIDS="$OWNED_PIDS $watcher"
run_loop "$WORK/drift.config.json" "$WORK/drift.out" "$WORK/drift.err"; drift_rc=$KOD
wait "$watcher" >/dev/null 2>&1 || true
OWNED_PIDS="${OWNED_PIDS% $watcher}"
if [ "$drift_rc" -ne 1 ] || ! attesterad "$WORK/drift-att" a-drift-anchor \
  || [ "$(starter b-drift-target)" != "0" ] || attesterad "$WORK/drift-att" b-drift-target \
  || [ "$(event_for "$WORK/drift-st" b-drift-target)" != "1" ] \
  || [ -e "$WORK/drift-br/b-drift-target" ] || [ -s "$UT/drift-gate.log" ] \
  || [ -n "$(lease_owner "$WORK/drift-le")" ]; then
  no "K15 taskpost omkontrolleras överst i varvet efter lease" \
    "exit/anchor/start2/attest2/event2/brytare2/gatemark=$drift_rc/$(attesterad "$WORK/drift-att" a-drift-anchor && echo ja || echo nej)/$(starter b-drift-target)/$(attesterad "$WORK/drift-att" b-drift-target && echo ja || echo nej)/$(event_for "$WORK/drift-st" b-drift-target)/$([ -e "$WORK/drift-br/b-drift-target" ] && echo ja || echo nej)/$([ -s "$UT/drift-gate.log" ] && echo ja || echo nej)"
elif [ ! -s "$UT/drift-mutated" ]; then
  no "K15 driftprovokationen skedde" "watchern hann aldrig mutera grinden"
else ok "K15 post-lease drift: första tasken attesterad, nästa stoppad före workspace/session; driven grind kördes aldrig"; fi
cp "$WORK/drift.original" "$FIXROOT/drift.sh"; chmod +x "$FIXROOT/drift.sh"
vakt_runtime post-lease-drift || { echo; summera; }

