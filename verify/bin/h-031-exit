checks: list[tuple[str, bool, str]] = []


class DuplicateKey(ValueError):
    pass


class ProductFailure(RuntimeError):
    pass


def effect_guard(effects, name):
    def reject(*args, **kwargs):
        effects.append((name, repr(args[:3]), sorted(kwargs)))
        raise ProductFailure(f"guarded pre-role effect: {name}")
    return reject


def install_effect_guards(effects):
    saved = []
    for name in sorted(GUARDED_OS_NAMES):
        function = getattr(os, name, None)
        if callable(function):
            saved.append((os, name, function))
            setattr(os, name, effect_guard(effects, "os." + name))
    saved.append((subprocess, "Popen", subprocess.Popen))
    subprocess.Popen = effect_guard(effects, "subprocess.Popen")
    saved.append((fcntl, "flock", fcntl.flock))
    fcntl.flock = effect_guard(effects, "fcntl.flock")
    for name in ("fcntl", "ioctl"):
        function = getattr(fcntl, name, None)
        if callable(function):
            saved.append((fcntl, name, function))
            setattr(fcntl, name, effect_guard(effects, "fcntl." + name))
    return saved


def restore_effect_guards(saved):
    for target, name, function in reversed(saved):
        setattr(target, name, function)


def measure_umask():
    value = os.umask(0o077)
    os.umask(value)
    return value


def audit_effect_hook(active, effects):
    write_flags = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
    def hook(event, args):
        if not active[0]:
            return
        forbidden = event in AUDIT_MUTATION_EVENTS
        if event == "open":
            mode = args[1] if len(args) > 1 else None
            flags = args[2] if len(args) > 2 else 0
            forbidden = ((isinstance(mode, str) and any(char in mode for char in "wax+"))
                         or (isinstance(flags, int) and flags & write_flags))
        if forbidden:
            effects.append((event, repr(args[:3])))
            raise ProductFailure(f"forbidden pre-role effect: {event}")
    return hook


def strict_json(raw: str):
    def pairs(items):
        out = {}
        for key, value in items:
            if key in out:
                raise DuplicateKey(key)
            out[key] = value
        return out
    return json.loads(raw, object_pairs_hook=pairs)


def check(key: str, ok: bool, detail: str) -> None:
    checks.append((key, bool(ok), detail))


def odombart(key: str, detail: str) -> None:
    print(f"ODÖMBART {key} — {detail}")
    raise SystemExit(2)


def sh(*argv: str, cwd: Path | None = None) -> str:
    if not argv or argv[0] != GIT:
        raise RuntimeError("judge helper permits only exact system Git")
    p = subprocess.run(argv, cwd=cwd, text=True, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, timeout=20)
    if p.returncode:
        raise RuntimeError(f"git rc={p.returncode}: {p.stdout}")
    return p.stdout


def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def task_row_valid(rows) -> bool:
    hits = [row for row in rows if isinstance(row, dict) and row.get("id") == "h-031"]
    if len(hits) != 1:
        return False
    row = hits[0]
    return (
        row.get("slice") == 16
        and row.get("authority_class") == "ordinary"
        and row.get("depends_on") == ["h-032"]
        and row.get("exit_test") == "verify/bin/h-031-exit"
        and row.get("allowed_write") == [
            "scripts/nortropic-codex-autopilot.py",
            "docs/05-beslutslogg.md",
            "docs/loop/drift.md",
        ]
        and row.get("owner_author_allowed_write") == []
    )


def owner_map(tree: ast.Module) -> dict[ast.AST, str]:
    owners: dict[ast.AST, str] = {}
    def walk(node: ast.AST, owner: str = "<module>", cls: str = "") -> None:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            owner = f"{cls}.{node.name}" if cls else node.name
        elif isinstance(node, ast.Lambda):
            owner = f"<lambda@{getattr(node, 'lineno', 0)}>"
        next_cls = f"{cls}.{node.name}".strip(".") if isinstance(node, ast.ClassDef) else cls
        owners[node] = owner
        for child in ast.iter_child_nodes(node):
            walk(child, owner, next_cls)
    walk(tree)
    return owners


def protected_callback_transfers(tree: ast.Module) -> list[tuple[int, str]]:
    """Reject an unobservable C-to-C transfer of the retained-fd probe.

    H032 can observe a captured C callable when Python invokes it directly and can
    observe every Python helper/closure frame.  CPython does not emit the nested
    c_call when a C executor such as map invokes another captured C callable.  This
    deliberately small graph follows only the protected os.fstat capability; it is
    not a Python control-flow interpreter and unrelated higher-order code is inert.
    """
    scope_parent: dict[ast.AST, ast.AST | None] = {tree: None}
    node_scope: dict[ast.AST, ast.AST] = {}
    scopes: list[ast.AST] = [tree]

    def mark(node: ast.AST, scope: ast.AST) -> None:
        node_scope[node] = scope
        if isinstance(node, (ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)):
            scope_parent[node] = scope
            scopes.append(node)
            for generator in node.generators:
                mark(generator.iter, node)
                mark(generator.target, node)
                for condition in generator.ifs:
                    mark(condition, node)
            if isinstance(node, ast.DictComp):
                mark(node.key, node)
                mark(node.value, node)
            else:
                mark(node.elt, node)
            return
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                for decorator in node.decorator_list:
                    mark(decorator, scope)
                for default in (*node.args.defaults,
                                *(item for item in node.args.kw_defaults if item is not None)):
                    mark(default, scope)
                if node.returns is not None:
                    mark(node.returns, scope)
            scope_parent[node] = scope
            scopes.append(node)
            for arg in (*node.args.posonlyargs, *node.args.args, *node.args.kwonlyargs):
                node_scope[arg] = node
            if node.args.vararg is not None:
                node_scope[node.args.vararg] = node
            if node.args.kwarg is not None:
                node_scope[node.args.kwarg] = node
            body = node.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) else [node.body]
            for child in body:
                mark(child, node)
            return
        for child in ast.iter_child_nodes(node):
            mark(child, scope)

    mark(tree, tree)
    local_names: dict[ast.AST, set[str]] = {scope: set() for scope in scopes}
    function_bindings: dict[tuple[str, int, str], ast.AST] = {}

    def variable(scope: ast.AST, name: str) -> tuple[str, int, str]:
        return ("var", id(scope), name)

    for scope in scopes:
        if isinstance(scope, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            local_names[scope].update(
                arg.arg for arg in (*scope.args.posonlyargs, *scope.args.args,
                                    *scope.args.kwonlyargs))
            if scope.args.vararg is not None:
                local_names[scope].add(scope.args.vararg.arg)
            if scope.args.kwarg is not None:
                local_names[scope].add(scope.args.kwarg.arg)
    for node in ast.walk(tree):
        scope = node_scope.get(node, tree)
        if isinstance(node, ast.Name) and isinstance(node.ctx, (ast.Store, ast.Del)):
            local_names[scope].add(node.id)
        elif isinstance(node, ast.Import):
            local_names[scope].update(alias.asname or alias.name.split(".", 1)[0]
                                      for alias in node.names)
        elif isinstance(node, ast.ImportFrom):
            local_names[scope].update(alias.asname or alias.name for alias in node.names)
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            defining_scope = node_scope.get(node, tree)
            local_names[defining_scope].add(node.name)
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
                function_bindings[variable(defining_scope, node.name)] = node
        elif isinstance(node, ast.ExceptHandler) and isinstance(node.name, str):
            local_names[scope].add(node.name)

    def resolve(scope: ast.AST, name: str) -> tuple[str, int, str]:
        current: ast.AST | None = scope
        while current is not None:
            if name in local_names[current]:
                return variable(current, name)
            current = scope_parent.get(current)
        return variable(tree, name)

    edges: dict[tuple[object, ...], set[tuple[object, ...]]] = {}
    protected: set[tuple[object, ...]] = set()
    c_executors: set[tuple[object, ...]] = set()
    python_functions: dict[tuple[object, ...], set[ast.AST]] = {
        binding: {function} for binding, function in function_bindings.items()
    }
    containers: list[ast.AST] = []
    object_stores: list[tuple[ast.AST, tuple[object, ...]]] = []
    calls: list[ast.Call] = []

    def expression(node: ast.AST) -> tuple[object, ...]:
        return ("expr", id(node))

    def returned(function: ast.AST) -> tuple[object, ...]:
        return ("return", id(function))

    def add_edge(target: tuple[object, ...], source: tuple[object, ...]) -> bool:
        sources = edges.setdefault(target, set())
        before = len(sources)
        sources.add(source)
        return len(sources) != before

    def is_unbound_builtin(scope: ast.AST, name: str) -> bool:
        current: ast.AST | None = scope
        while current is not None:
            if name in local_names[current]:
                return False
            current = scope_parent.get(current)
        return True

    def target_edges(target: ast.AST, source: tuple[object, ...]) -> None:
        if isinstance(target, ast.Name):
            add_edge(resolve(node_scope.get(target, tree), target.id), source)
        elif isinstance(target, (ast.Tuple, ast.List)):
            for item in target.elts:
                target_edges(item, source)
        elif isinstance(target, ast.Starred):
            target_edges(target.value, source)
        elif isinstance(target, (ast.Attribute, ast.Subscript)):
            object_stores.append((target, source))
            if isinstance(target.value, ast.Name):
                add_edge(resolve(node_scope.get(target.value, tree), target.value.id), source)
            else:
                add_edge(expression(target.value), source)

    module_os = variable(tree, "os")
    for node in ast.walk(tree):
        scope = node_scope.get(node, tree)
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load):
            add_edge(expression(node), resolve(scope, node.id))
            if (node.id in {"map", "filter", "sorted", "min", "max"}
                    and is_unbound_builtin(scope, node.id)):
                c_executors.add(expression(node))
        elif (isinstance(node, ast.Attribute) and node.attr == "fstat"
              and isinstance(node.value, ast.Name)
              and resolve(scope, node.value.id) == module_os):
            protected.add(expression(node))
        elif isinstance(node, ast.Attribute):
            add_edge(expression(node), expression(node.value))
        elif isinstance(node, ast.Assign):
            for target in node.targets:
                target_edges(target, expression(node.value))
        elif isinstance(node, ast.AnnAssign) and node.value is not None:
            target_edges(node.target, expression(node.value))
        elif isinstance(node, ast.NamedExpr):
            target_edges(node.target, expression(node.value))
            add_edge(expression(node), expression(node.value))
        elif isinstance(node, (ast.Tuple, ast.List, ast.Set)):
            containers.append(node)
            for item in node.elts:
                add_edge(expression(node), expression(item))
        elif isinstance(node, ast.Dict):
            containers.append(node)
            for item in (*node.keys, *node.values):
                if item is not None:
                    add_edge(expression(node), expression(item))
        elif isinstance(node, ast.Subscript):
            add_edge(expression(node), expression(node.value))
        elif isinstance(node, (ast.IfExp, ast.BoolOp)):
            values = node.values if isinstance(node, ast.BoolOp) else [node.body, node.orelse]
            for item in values:
                add_edge(expression(node), expression(item))
        elif isinstance(node, ast.Return) and node.value is not None:
            function = scope if isinstance(scope, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)) else None
            if function is not None:
                add_edge(returned(function), expression(node.value))
        elif isinstance(node, ast.Lambda):
            add_edge(returned(node), expression(node.body))
            python_functions.setdefault(expression(node), set()).add(node)
        elif isinstance(node, ast.Call):
            calls.append(node)
            function = None
            if isinstance(node.func, ast.Name):
                function = function_bindings.get(resolve(scope, node.func.id))
            if isinstance(function, (ast.FunctionDef, ast.AsyncFunctionDef)):
                positional = [*function.args.posonlyargs, *function.args.args]
                for formal, actual in zip(positional, node.args):
                    if not isinstance(actual, ast.Starred):
                        add_edge(variable(function, formal.arg), expression(actual))
                formal_names = {arg.arg: arg for arg in (*positional, *function.args.kwonlyargs)}
                for keyword in node.keywords:
                    if keyword.arg in formal_names:
                        add_edge(variable(function, keyword.arg), expression(keyword.value))
                add_edge(expression(node), returned(function))

    for function in [scope for scope in scopes
                     if isinstance(scope, (ast.FunctionDef, ast.AsyncFunctionDef))]:
        positional = [*function.args.posonlyargs, *function.args.args]
        default_formals = positional[len(positional) - len(function.args.defaults):]
        for formal, default in zip(default_formals, function.args.defaults):
            add_edge(variable(function, formal.arg), expression(default))
        for formal, default in zip(function.args.kwonlyargs, function.args.kw_defaults):
            if default is not None:
                add_edge(variable(function, formal.arg), expression(default))

    changed = True
    while changed:
        changed = False
        for target, sources in edges.items():
            if target not in protected and any(source in protected for source in sources):
                protected.add(target)
                changed = True
            if target not in c_executors and any(source in c_executors for source in sources):
                c_executors.add(target)
                changed = True
            inherited = set().union(*(python_functions.get(source, set()) for source in sources))
            if inherited - python_functions.get(target, set()):
                python_functions.setdefault(target, set()).update(inherited)
                changed = True
        for call in calls:
            for function in python_functions.get(expression(call.func), set()):
                if not isinstance(function, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
                    continue
                positional = [*function.args.posonlyargs, *function.args.args]
                for formal, actual in zip(positional, call.args):
                    if not isinstance(actual, ast.Starred):
                        changed |= add_edge(variable(function, formal.arg), expression(actual))
                formal_names = {arg.arg: arg for arg in (*positional, *function.args.kwonlyargs)}
                for keyword in call.keywords:
                    if keyword.arg in formal_names:
                        changed |= add_edge(variable(function, keyword.arg), expression(keyword.value))
                changed |= add_edge(expression(call), returned(function))

    findings: list[tuple[int, str]] = []
    for container in containers:
        if expression(container) in protected:
            findings.append((getattr(container, "lineno", 0), "protected-callback-container"))
    for target, source in object_stores:
        if source in protected:
            findings.append((getattr(target, "lineno", 0), "protected-callback-container"))
    for call in calls:
        transferred = [item for item in call.args if expression(item) in protected]
        transferred.extend(keyword.value for keyword in call.keywords
                           if expression(keyword.value) in protected)
        if transferred and expression(call.func) in c_executors:
            findings.append((getattr(call, "lineno", 0), "protected-callback-c-executor"))
    return sorted(set(findings))


def process_shape(text: str) -> dict[str, object]:
    try:
        tree = ast.parse(text)
    except SyntaxError as exc:
        return {"boundary_ok": False, "observer_ok": False, "detail": f"syntax:{exc}"}
    owners = owner_map(tree)
    parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
    annotation_nodes: set[ast.AST] = set()
    for candidate in ast.walk(tree):
        annotations = []
        if isinstance(candidate, ast.arg) and candidate.annotation is not None:
            annotations.append(candidate.annotation)
        elif isinstance(candidate, (ast.FunctionDef, ast.AsyncFunctionDef)) and candidate.returns is not None:
            annotations.append(candidate.returns)
        elif isinstance(candidate, ast.AnnAssign):
            annotations.append(candidate.annotation)
        for annotation in annotations:
            annotation_nodes.update(ast.walk(annotation))
    funcs = {node.name for node in ast.walk(tree)
             if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))}
    calls: dict[str, set[str]] = {name: set() for name in funcs}
    sites: list[tuple[str, str, int, str]] = []
    violations: list[tuple[str, int, str]] = []
    import_inventory: list[str] = []
    os_effect_counts: dict[str, int] = {}
    fcntl_effect_counts: dict[str, int] = {}
    sys_stream_counts: dict[str, int] = {}
    sys_state_counts: dict[str, int] = {}
    authority_assignments = 0
    expected_repository_root_assignment = ast.parse(
        'REPOSITORY_ROOT = Path(__file__).resolve().parents[1]'
    ).body[0]
    expected_authority_assignment = ast.parse(
        'AUTHORITY_LIB = Path(__file__).resolve().parents[1] / "controller/authority"'
    ).body[0]
    protected_roots={"AUTHORITY_LIB","REPOSITORY_ROOT"}
    protected_callback_findings = protected_callback_transfers(tree)
    violations.extend(("<capability>", line, reason)
                      for line, reason in protected_callback_findings)

    for node in ast.walk(tree):
        owner = owners.get(node, "<module>")
        if (isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
                and node.name in ({"str", "Path", "__file__"}|protected_roots)):
            violations.append((owner, node.lineno, f"protected-binding:{node.name}"))
        if isinstance(node, ast.arg) and node.arg in ({"str", "Path", "__file__"}|protected_roots):
            violations.append((owner, node.lineno, f"protected-argument:{node.arg}"))
        if (isinstance(node, ast.ExceptHandler)
                and node.name in ({"str", "Path", "__file__"}|protected_roots)):
            violations.append((owner, node.lineno, f"protected-except-binding:{node.name}"))
        if isinstance(node, (ast.Global, ast.Nonlocal)):
            protected_declarations = sorted(
                set(node.names) & ({"str", "Path", "__file__"}|protected_roots))
            if protected_declarations:
                violations.append((owner, node.lineno,
                                   f"protected-declaration:{protected_declarations}"))
        if isinstance(node, ast.Assign) and any(
                isinstance(target, ast.Name) and target.id in protected_roots
                for target in node.targets):
            if ast.dump(node, include_attributes=False) in {
                    ast.dump(expected_authority_assignment, include_attributes=False),
                    ast.dump(expected_repository_root_assignment, include_attributes=False)}:
                authority_assignments += 1
            else:
                violations.append((owner, node.lineno, "repository-root-assignment"))
        if (isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store)
                and node.id in {"str", "Path", "__file__"}):
            violations.append((owner, node.lineno, f"protected-binding:{node.id}"))
        if (isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store)
                and node.id in protected_roots
                and not isinstance(parents.get(node), ast.Assign)):
            violations.append((owner, node.lineno, "repository-root-rebinding"))
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load) and node.id == "Path":
            parent = parents.get(node)
            grandparent = parents.get(parent) if parent is not None else None
            direct_path_call = isinstance(parent, ast.Call) and parent.func is node
            direct_path_class_call = (
                isinstance(parent, ast.Attribute) and parent.value is node
                and isinstance(grandparent, ast.Call) and grandparent.func is parent
                and parent.attr == "home"
                and not grandparent.args and not grandparent.keywords
            )
            if node not in annotation_nodes and not direct_path_call and not direct_path_class_call:
                violations.append((owner, node.lineno, "capturable-path-class"))
        if isinstance(node, ast.AsyncFunctionDef):
            violations.append((owner, node.lineno, f"deferred-async-function:{node.name}"))
        if (isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
                and node.name.startswith("__") and node.name.endswith("__")
                and node.name != "__init__"):
            violations.append((owner, node.lineno, f"dynamic-lifecycle-method:{node.name}"))
        if isinstance(node, ast.ClassDef) and node.keywords:
            violations.append((owner, node.lineno, "dynamic-class-keywords"))
        if isinstance(node, ast.Constant) and node.value == "__del__":
            violations.append((owner, node.lineno, "dynamic-finalizer-key"))
        if isinstance(node, (ast.Assign, ast.AnnAssign, ast.NamedExpr, ast.AugAssign)):
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            if any(isinstance(item, ast.Name) and item.id == "__del__"
                   for target in targets for item in ast.walk(target)):
                violations.append((owner, node.lineno, "deferred-finalizer-assignment:__del__"))
        if isinstance(node, (ast.Yield, ast.YieldFrom, ast.Await)):
            violations.append((owner, node.lineno, f"deferred-language-node:{type(node).__name__}"))
        if isinstance(node, ast.Import):
            for alias in node.names:
                import_inventory.append(f"I:{alias.name}:{alias.asname or ''}")
                if alias.name == "importlib" or alias.name.startswith("importlib."):
                    violations.append((owner, node.lineno, f"dynamic-import-module:{alias.name}"))
                if alias.name == "builtins" or alias.name.startswith("builtins."):
                    violations.append((owner, node.lineno, f"dynamic-builtins-module:{alias.name}"))
                if alias.name in PROCESS_ATTRS and alias.asname is not None:
                    violations.append((owner, node.lineno, f"import-alias:{alias.name} as {alias.asname}"))
        elif isinstance(node, ast.ImportFrom):
            for alias in node.names:
                import_inventory.append(
                    f"F:{node.level}:{node.module or ''}:{alias.name}:{alias.asname or ''}")
            if node.module in PROCESS_ATTRS:
                violations.append((owner, node.lineno, f"from-import:{node.module}"))
            if node.module == "importlib" or (node.module or "").startswith("importlib."):
                violations.append((owner, node.lineno, f"dynamic-from-import:{node.module}"))
            if node.module == "builtins" or (node.module or "").startswith("builtins."):
                violations.append((owner, node.lineno, f"dynamic-builtins-from-import:{node.module}"))
        elif isinstance(node, (ast.Assign, ast.AnnAssign)) and node.value is not None:
            if isinstance(node.value, ast.Name) and node.value.id in PROCESS_ATTRS:
                violations.append((owner, node.lineno, f"module-assignment:{node.value.id}"))
        if isinstance(node, ast.Name) and node.id in PROCESS_ATTRS and isinstance(node.ctx, ast.Load):
            parent = parents.get(node)
            safe_getattr = (
                isinstance(parent, ast.Call)
                and isinstance(parent.func, ast.Name)
                and parent.func.id == "getattr"
                and len(parent.args) >= 2
                and parent.args[0] is node
                and isinstance(parent.args[1], ast.Constant)
                and isinstance(parent.args[1].value, str)
                and parent.args[1].value not in PROCESS_ATTRS[node.id]
                and parent.args[1].value != "__dict__"
            )
            if not ((isinstance(parent, ast.Attribute) and parent.value is node) or safe_getattr):
                violations.append((owner, node.lineno, f"bare-process-module:{node.id}"))
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Load):
            parent = parents.get(node)
            direct_call = isinstance(parent, ast.Call) and parent.func is node
            if node.id in {
                "__import__", "__builtins__", "__loader__", "__spec__", "__package__",
                "__cached__", "vars", "locals", "eval", "exec", "compile", "breakpoint", "help",
                "setattr", "delattr",
            }:
                violations.append((owner, node.lineno, f"sensitive-builtin:{node.id}"))
            elif node.id in {"getattr", "globals", "type"} and not direct_call:
                violations.append((owner, node.lineno, f"sensitive-builtin-reference:{node.id}"))
        if isinstance(node, ast.Name) and node.id == "sys" and isinstance(node.ctx, ast.Load):
            parent = parents.get(node)
            direct_attribute = isinstance(parent, ast.Attribute) and parent.value is node
            if not direct_attribute:
                violations.append((owner, node.lineno, "bare-sys-module"))
            elif parent.attr not in ALLOWED_SYS_ATTRS:
                violations.append((owner, node.lineno, f"unapproved-sys-attribute:sys.{parent.attr}"))
            elif parent.attr == "dont_write_bytecode":
                state_parent = parents.get(parent)
                safe_bytecode_state = (
                    owner == "<module>"
                    and isinstance(state_parent, ast.Assign)
                    and state_parent.targets == [parent]
                    and isinstance(state_parent.value, ast.Constant)
                    and state_parent.value.value is True
                )
                if safe_bytecode_state:
                    key = f"{owner}:dont_write_bytecode=True"
                    sys_state_counts[key] = sys_state_counts.get(key, 0) + 1
                else:
                    violations.append((owner, node.lineno, "mutable-sys-dont-write-bytecode"))
            elif parent.attr == "path":
                state_parent = parents.get(parent)
                state_grandparent = parents.get(state_parent)
                state_args = state_grandparent.args if isinstance(state_grandparent, ast.Call) else []
                safe_path_insert = (
                    owner == "<module>"
                    and isinstance(state_parent, ast.Attribute)
                    and state_parent.value is parent and state_parent.attr == "insert"
                    and isinstance(state_grandparent, ast.Call)
                    and state_grandparent.func is state_parent and not state_grandparent.keywords
                    and len(state_args) == 2
                    and isinstance(state_args[0], ast.Constant) and state_args[0].value == 0
                    and isinstance(state_args[1], ast.Call)
                    and isinstance(state_args[1].func, ast.Name) and state_args[1].func.id == "str"
                    and len(state_args[1].args) == 1 and not state_args[1].keywords
                    and isinstance(state_args[1].args[0], ast.Name)
                    and state_args[1].args[0].id in protected_roots
                )
                if safe_path_insert:
                    key = f"{owner}:path.insert"
                    sys_state_counts[key] = sys_state_counts.get(key, 0) + 1
                else:
                    violations.append((owner, node.lineno, "mutable-sys-path"))
            elif parent.attr == "stdout":
                stream_parent = parents.get(parent)
                stream_grandparent = parents.get(stream_parent)
                safe_stdout = (
                    owner == "run_codex"
                    and isinstance(stream_parent, ast.Attribute)
                    and stream_parent.value is parent and stream_parent.attr == "write"
                    and isinstance(stream_grandparent, ast.Call)
                    and stream_grandparent.func is stream_parent
                )
                if safe_stdout:
                    key = f"{owner}:stdout.write"
                    sys_stream_counts[key] = sys_stream_counts.get(key, 0) + 1
                else:
                    violations.append((owner, node.lineno, "capturable-sys-stdout"))
            elif parent.attr == "stderr":
                stream_parent = parents.get(parent)
                stream_grandparent = parents.get(stream_parent)
                safe_stderr = (
                    owner == "main"
                    and isinstance(stream_parent, ast.keyword) and stream_parent.arg == "file"
                    and stream_parent.value is parent
                    and isinstance(stream_grandparent, ast.Call)
                    and isinstance(stream_grandparent.func, ast.Name)
                    and stream_grandparent.func.id == "print"
                )
                if safe_stderr:
                    key = f"{owner}:stderr.print"
                    sys_stream_counts[key] = sys_stream_counts.get(key, 0) + 1
                else:
                    violations.append((owner, node.lineno, "capturable-sys-stderr"))
        if isinstance(node, ast.Name) and node.id == "fcntl" and isinstance(node.ctx, ast.Load):
            parent = parents.get(node)
            if not (isinstance(parent, ast.Attribute) and parent.value is node):
                violations.append((owner, node.lineno, "bare-fcntl-module"))
            elif parent.attr not in {"LOCK_EX", "LOCK_NB", "flock"}:
                violations.append((owner, node.lineno,
                                   f"unapproved-fcntl-attribute:fcntl.{parent.attr}"))
            elif parent.attr == "flock":
                effect_parent = parents.get(parent)
                if not (isinstance(effect_parent, ast.Call) and effect_parent.func is parent):
                    violations.append((owner, node.lineno, "fcntl-effect-reference:fcntl.flock"))
                else:
                    key = f"{owner}:flock"
                    fcntl_effect_counts[key] = fcntl_effect_counts.get(key, 0) + 1
        if isinstance(node, ast.Name) and node.id == "os" and isinstance(node.ctx, ast.Load):
            parent = parents.get(node)
            safe_getattr = (
                isinstance(parent, ast.Call)
                and isinstance(parent.func, ast.Name) and parent.func.id == "getattr"
                and len(parent.args) == 3 and parent.args[0] is node
                and isinstance(parent.args[1], ast.Constant)
                and parent.args[1].value in {"O_CLOEXEC", "O_NOFOLLOW"}
                and isinstance(parent.args[2], ast.Constant) and parent.args[2].value == 0
                and not parent.keywords
            )
            if isinstance(parent, ast.Attribute) and parent.value is node:
                if parent.attr not in ALLOWED_OS_ATTRS and parent.attr not in PROCESS_ATTRS["os"]:
                    violations.append((owner, node.lineno,
                                       f"unapproved-os-attribute:os.{parent.attr}"))
                if parent.attr == "environ":
                    environ_parent = parents.get(parent)
                    environ_grandparent = parents.get(environ_parent)
                    safe_environ_read = (
                        isinstance(environ_parent, ast.Attribute)
                        and environ_parent.value is parent and environ_parent.attr == "items"
                        and isinstance(environ_grandparent, ast.Call)
                        and environ_grandparent.func is environ_parent
                        and not environ_grandparent.args and not environ_grandparent.keywords
                    )
                    if not safe_environ_read:
                        violations.append((owner, node.lineno, "mutable-os-environ-access"))
                if parent.attr in DIRECT_OS_EFFECT_ATTRS:
                    effect_parent = parents.get(parent)
                    if not (isinstance(effect_parent, ast.Call) and effect_parent.func is parent):
                        violations.append((owner, node.lineno,
                                           f"os-effect-reference:os.{parent.attr}"))
                    else:
                        key = f"{owner}:{parent.attr}"
                        os_effect_counts[key] = os_effect_counts.get(key, 0) + 1
            elif not safe_getattr:
                violations.append((owner, node.lineno, "bare-os-module"))
        if isinstance(node, ast.Attribute) and isinstance(node.value, ast.Name):
            module, attr = node.value.id, node.attr
            if module in PROCESS_ATTRS and attr == "__dict__":
                violations.append((owner, node.lineno, f"process-dictionary:{module}"))
            if module in PROCESS_ATTRS and attr in PROCESS_ATTRS[module]:
                parent = parents.get(node)
                if not (isinstance(parent, ast.Call) and parent.func is node):
                    violations.append((owner, node.lineno, f"process-reference:{module}.{attr}"))
        if isinstance(node, ast.Attribute) and node.attr.startswith("_"):
            safe_super_init = (
                node.attr == "__init__"
                and isinstance(node.value, ast.Call)
                and isinstance(node.value.func, ast.Name) and node.value.func.id == "super"
                and not node.value.args and not node.value.keywords
            )
            if not safe_super_init:
                violations.append((owner, node.lineno, f"private-reflection:{node.attr}"))
        if isinstance(node, ast.Attribute) and node.attr in SENSITIVE_MODULE_PROXIES:
            violations.append((owner, node.lineno, f"sensitive-module-proxy:{node.attr}"))
        if isinstance(node, ast.Attribute) and node.attr in SENSITIVE_FRAME_ATTRS:
            violations.append((owner, node.lineno, f"sensitive-frame-reflection:{node.attr}"))
        if not isinstance(node, ast.Call):
            continue
        if (owner == "<module>" and isinstance(node.func, ast.Attribute)
                and node.func.attr in MODULE_EFFECT_METHODS):
            violations.append((owner, node.lineno,
                               f"module-import-effect-method:{node.func.attr}"))
        if isinstance(node.func, ast.Name) and node.func.id in {"eval", "exec", "compile"}:
            violations.append((owner, node.lineno, f"dynamic-code:{node.func.id}"))
        if isinstance(node.func, ast.Name) and node.func.id == "type":
            parent = parents.get(node)
            compared = ([parent.left] + list(parent.comparators)
                        if isinstance(parent, ast.Compare) else [])
            safe_type_check = (
                len(node.args) == 1 and not node.keywords
                and isinstance(parent, ast.Compare)
                and all(isinstance(op, (ast.Is, ast.IsNot)) for op in parent.ops)
                and any(isinstance(item, ast.Name) and item.id in {"int", "str"}
                        for item in compared if item is not node)
            )
            if not safe_type_check:
                violations.append((owner, node.lineno, "dynamic-type-construction"))
        if isinstance(node.func, ast.Name) and node.func.id in {"globals", "locals", "vars"}:
            parent = parents.get(node)
            grandparent = parents.get(parent) if parent is not None else None
            safe_source_lookup = (
                node.func.id == "globals"
                and isinstance(parent, ast.Attribute) and parent.value is node and parent.attr == "get"
                and isinstance(grandparent, ast.Call) and grandparent.func is parent
                and len(grandparent.args) == 2
                and all(isinstance(arg, ast.Constant) for arg in grandparent.args)
                and [arg.value for arg in grandparent.args] == ["__file__", ""]
            )
            if not safe_source_lookup:
                violations.append((owner, node.lineno, f"dynamic-namespace:{node.func.id}"))
        if isinstance(node.func, ast.Name) and node.func.id == "getattr":
            safe_os_flag = (
                len(node.args) == 3 and not node.keywords
                and isinstance(node.args[0], ast.Name) and node.args[0].id == "os"
                and isinstance(node.args[1], ast.Constant)
                and node.args[1].value in {"O_CLOEXEC", "O_NOFOLLOW"}
                and isinstance(node.args[2], ast.Constant) and node.args[2].value == 0
            )
            if not safe_os_flag:
                violations.append((owner, node.lineno, "dynamic-getattr"))
        if isinstance(node.func, ast.Name) and owner in calls and node.func.id in funcs:
            calls[owner].add(node.func.id)
        if isinstance(node.func, ast.Name) and node.func.id in {"getattr", "vars"} and node.args:
            target = node.args[0]
            if isinstance(target, ast.Name) and target.id in PROCESS_ATTRS:
                attr = node.args[1] if len(node.args) > 1 else None
                if (not isinstance(attr, ast.Constant) or not isinstance(attr.value, str)
                        or attr.value in PROCESS_ATTRS[target.id]):
                    violations.append((owner, node.lineno, f"dynamic-process-access:{target.id}"))
        if not (isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name)):
            continue
        module, attr = node.func.value.id, node.func.attr
        if module not in PROCESS_ATTRS or attr not in PROCESS_ATTRS[module]:
            continue
        unsafe_keywords = sorted(
            "**" if keyword.arg is None else keyword.arg
            for keyword in node.keywords
            if keyword.arg is None or keyword.arg in {"shell", "executable", "preexec_fn"}
        )
        if unsafe_keywords:
            violations.append((owner, node.lineno, f"unsafe-process-keywords:{unsafe_keywords}"))
        if module == "subprocess" and attr in {"Popen", "run"}:
            if len(node.args) != 1 or any(isinstance(arg, ast.Starred) for arg in node.args):
                violations.append((owner, node.lineno,
                                   f"unsafe-process-positional-arity:{module}.{attr}:{len(node.args)}"))
        literal = ""
        if node.args and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str):
            literal = node.args[0].value
        sites.append((owner, f"{module}.{attr}", node.lineno, literal))

    counts = {"run": 0, "run_codex": 0, "clear": 0}
    for owner, name, line, literal in sites:
        if owner == "run" and name == "subprocess.run":
            counts["run"] += 1
        elif owner == "run_codex" and name == "subprocess.Popen":
            counts["run_codex"] += 1
        elif owner == "watch" and name == "os.system" and literal == "clear":
            counts["clear"] += 1
        else:
            violations.append((owner, line, name))

    def reachable(start: str) -> set[str]:
        seen, todo = set(), [start]
        while todo:
            cur = todo.pop()
            if cur in seen:
                continue
            seen.add(cur)
            todo.extend(calls.get(cur, ()))
        return seen

    observer_hits = {name: sorted(reachable(name) & {"run_codex"})
                     for name in ("status", "watch", "roadmap_status")}
    observer_hits = {name: hit for name, hit in observer_hits.items() if hit}
    inventory_ok = tuple(sorted(import_inventory)) in {
        tuple(LEGACY_EXPECTED_IMPORT_INVENTORY),
        tuple(RESULT_KERNEL_EXPECTED_IMPORT_INVENTORY),
    }
    if not inventory_ok:
        violations.append(("<module>", 0, f"import-inventory:{sorted(import_inventory)}"))
    if os_effect_counts not in (LEGACY_EXPECTED_OS_EFFECT_COUNTS,
                                RESULT_KERNEL_EXPECTED_OS_EFFECT_COUNTS):
        violations.append(("<module>", 0, f"os-effect-inventory:{os_effect_counts}"))
    if fcntl_effect_counts != EXPECTED_FCNTL_EFFECT_COUNTS:
        violations.append(("<module>", 0, f"fcntl-effect-inventory:{fcntl_effect_counts}"))
    if sys_stream_counts != EXPECTED_SYS_STREAM_COUNTS:
        violations.append(("<module>", 0, f"sys-stream-inventory:{sys_stream_counts}"))
    if sys_state_counts != EXPECTED_SYS_STATE_COUNTS:
        violations.append(("<module>", 0, f"sys-state-inventory:{sys_state_counts}"))
    if authority_assignments != 1:
        violations.append(("<module>", 0, f"repository-root-count:{authority_assignments}"))
    exact = counts == {"run": 1, "run_codex": 1, "clear": 1}
    return {
        "boundary_ok": exact and not violations,
        "observer_ok": not observer_hits,
        "funcs": funcs,
        "detail": f"counts={counts} imports_exact={inventory_ok} sites={sites} violations={violations}",
        "observer_hits": observer_hits,
    }


def inject_run_codex_prefix(text: str, statements: str) -> str:
    tree = ast.parse(text)
    functions = [node for node in tree.body
                 if isinstance(node, ast.FunctionDef) and node.name == "run_codex"]
    if len(functions) != 1 or not functions[0].body:
        raise ValueError("exact run_codex body unavailable")
    first_line = functions[0].body[0].lineno - 1
    lines = text.splitlines(keepends=True)
    insertion = "".join("    " + line + "\n" for line in statements.splitlines())
    lines.insert(first_line, insertion)
    return "".join(lines)


def route_observation(argv: list[str]) -> dict[str, object]:
    models: list[str] = []
    efforts: list[str] = []
    config_models: list[str] = []
    malformed: list[str] = []
    ignore_count = argv.count("--ignore-user-config")
    forbidden = [arg for arg in argv
                 if arg in {"--oss", "--profile", "-p", "--local-provider"}
                 or arg.startswith("--profile=") or arg.startswith("--local-provider=")
                 or (arg.startswith("-p") and len(arg) > 2)]
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in {"-m", "--model"}:
            if i + 1 >= len(argv):
                malformed.append(arg); i += 1; continue
            models.append(argv[i + 1]); i += 2; continue
        if arg.startswith("--model="):
            models.append(arg.split("=", 1)[1])
        elif arg.startswith("-m="):
            models.append(arg[3:])
        elif arg.startswith("-m") and len(arg) > 2:
            models.append(arg[2:])
        value = None
        if arg in {"-c", "--config"}:
            if i + 1 >= len(argv):
                malformed.append(arg); i += 1; continue
            value = argv[i + 1]; i += 2
        elif arg.startswith("--config="):
            value = arg.split("=", 1)[1]; i += 1
        elif arg.startswith("-c="):
            value = arg[3:]; i += 1
        elif arg.startswith("-c") and len(arg) > 2:
            value = arg[2:]; i += 1
        else:
            i += 1
        if value is not None and "=" in value:
            key, raw = value.split("=", 1)
            parsed = raw.strip().strip("\"'")
            if key.strip() == "model_reasoning_effort":
                efforts.append(parsed)
            if key.strip() == "model":
                config_models.append(parsed)
    return {"models": models, "efforts": efforts, "config_models": config_models,
            "ignore_count": ignore_count, "forbidden": forbidden, "malformed": malformed}


def route_ok(argv: list[str], expected: tuple[str, str]) -> bool:
    observed = route_observation(argv)
    return (
        observed["models"] == [expected[0]]
        and observed["efforts"] == [expected[1]]
        and observed["config_models"] == []
        and observed["ignore_count"] == 1
        and observed["forbidden"] == []
        and observed["malformed"] == []
    )


