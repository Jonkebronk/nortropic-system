#!/usr/bin/python3
"""Install/remove only the reviewed H-033 authority artifacts.

Normal commands have one fixed destination. ``fixture-install`` exists solely
for unprivileged disposable layout tests; its files are non-setuid and are not
accepted by the production CLI or native services.
"""
import hashlib
import json
import os
import pwd
import stat
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
AUTHORITY = Path("/Library/Application Support/Nortropic/provenance")
PRODUCER = "_nortropic_provenance"
SERVICE_SHA = "da3b7900d6a24e6297db256186d490de50fee54f4c565710a225909f0638e686"
PROBE_SHA = "d17aecd9c4c2df98b945f6c53c5573e71a30e7b242657aeaffa56762d86902ef"
ALLOWLIST_SHA = "3e29e923ffe3904506c5c68d7e6b9250899d9b550f8a8efa7fb8b6ca7338cff7"
H034_SHA = "405ced0cb549f1b14b50b3f6fa88dab54083a74e291d563dbc32a63021fff5f3"
H034_MANIFEST_SHA = "18f57799f091fe4be8a829a1fbbe891f33b57d5f4d8a50df49f755082d5398a1"
ARTIFACT_MANIFEST_SHA = "069265c112ce1056fa4318d5eb6320cf781d9d272bb3ae82bf7573f586575aa0"
SERVICES = ("request-producer", "request-observer", "request-consumer")
PROBES = ("h033-auth-pass-v1", "h033-auth-fail-v1", "h033-auth-odombart-v1")


def stop(message):
    print("H033_PROVISIONING_ERROR=" + message, file=sys.stderr)
    raise SystemExit(2)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def stable_file(path, expected):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size <= 0:
            stop("invalid-source")
        first = os.pread(fd, before.st_size, 0)
        middle = os.fstat(fd)
        second = os.pread(fd, before.st_size, 0)
        after = os.fstat(fd)
    except OSError:
        stop("unreadable-source")
    finally:
        if "fd" in locals(): os.close(fd)
    identity = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_uid, s.st_gid,
                          s.st_nlink, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
    if first != second or identity(before) != identity(middle) or identity(middle) != identity(after):
        stop("unstable-source")
    if sha(first) != expected:
        stop("source-digest-mismatch")
    return first


def git_object(path, expected):
    try:
        q = subprocess.run(["/usr/bin/git", "--no-replace-objects", "-c", "core.fsmonitor=false",
                            "-C", str(REPO), "show", "HEAD:" + path],
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=5,
                           env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C",
                                "HOME": "/var/empty", "GIT_CONFIG_NOSYSTEM": "1",
                                "GIT_CONFIG_GLOBAL": "/dev/null", "TMPDIR": "/tmp",
                                "DARWIN_USER_TEMP_DIR": "/tmp"})
    except (OSError, subprocess.SubprocessError):
        stop("git-object-read-failed")
    if q.returncode or q.stderr or sha(q.stdout) != expected:
        stop("git-object-identity-mismatch")
    return q.stdout


def exact_sources():
    manifest_raw = stable_file(REPO / "controller/provenance/artifact-manifest.json",
                               ARTIFACT_MANIFEST_SHA)
    try:
        json.loads(manifest_raw, object_pairs_hook=lambda pairs: dict_no_duplicates(pairs))
    except (UnicodeError, ValueError, TypeError):
        stop("invalid-artifact-manifest")
    h034_manifest = git_object("verify/h034/identity-manifest.json", H034_MANIFEST_SHA)
    try:
        identity = json.loads(h034_manifest)
    except (UnicodeError, ValueError):
        stop("invalid-h034-manifest")
    if identity.get("artifact_sha256") != H034_SHA:
        stop("h034-manifest-binding-mismatch")
    return {
        "service": stable_file(REPO / "controller/provenance/dist/h033-service", SERVICE_SHA),
        "probe": stable_file(REPO / "controller/provenance/dist/h033-probe", PROBE_SHA),
        "allowlist": stable_file(REPO / "controller/provenance/probes.json", ALLOWLIST_SHA),
        "h034": git_object("verify/h034/kernel", H034_SHA),
    }


def dict_no_duplicates(pairs):
    out = {}
    for key, value in pairs:
        if key in out: raise ValueError("duplicate key")
        out[key] = value
    return out


def safe_dir(path, owner, mode, create, exact_mode=True):
    if path == Path("/"):
        return
    parent = path.parent
    if create and not parent.exists():
        stop("missing-protected-parent")
    try:
        if create:
            try: os.mkdir(path, mode)
            except FileExistsError: pass
        s = os.lstat(path)
    except OSError:
        stop("directory-unavailable")
    if not stat.S_ISDIR(s.st_mode) or stat.S_ISLNK(s.st_mode) or s.st_uid != owner or s.st_mode & 0o022:
        stop("directory-protection-mismatch")
    if exact_mode and stat.S_IMODE(s.st_mode) != mode:
        os.chmod(path, mode)


def install_leaf(path, raw, owner, group, mode):
    if path.exists() or path.is_symlink():
        try: s = os.lstat(path)
        except OSError: stop("existing-leaf-unreadable")
        if not stat.S_ISREG(s.st_mode) or s.st_uid != owner or s.st_mode & 0o022:
            stop("existing-leaf-protection-mismatch")
        if stable_file(path, sha(raw)) != raw:
            stop("existing-leaf-content-mismatch")
        os.chown(path, owner, group); os.chmod(path, mode)
        return
    temporary = path.parent / ("." + path.name + ".install." + str(os.getpid()))
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        done = 0
        while done < len(raw):
            written = os.write(fd, raw[done:])
            if written <= 0: raise OSError("zero-length write")
            done += written
        os.fsync(fd); os.fchown(fd, owner, group); os.fchmod(fd, mode); os.close(fd)
        os.rename(temporary, path)
    except OSError:
        try: os.close(fd)
        except (NameError, OSError): pass
        try: os.unlink(temporary)
        except OSError: pass
        stop("leaf-install-failed")


def install(root, fixture):
    if fixture:
        if os.geteuid() == 0: stop("fixture-must-be-unprivileged")
        owner = producer_uid = os.getuid(); group = os.getgid()
        if root == AUTHORITY or root == Path("/") or root.exists(): stop("fixture-root-must-be-new")
        sources = exact_sources()
        root.mkdir(mode=0o755)
    else:
        if os.geteuid() != 0 or root != AUTHORITY: stop("root-required")
        try: account = pwd.getpwnam(PRODUCER)
        except KeyError: stop("dedicated-account-missing")
        if account.pw_uid in (0, os.getuid()): stop("dedicated-account-not-separated")
        owner = 0; group = 0; producer_uid = account.pw_uid
        sources = exact_sources()
        safe_dir(Path("/Library"), 0, 0o755, False, False)
        safe_dir(Path("/Library/Application Support"), 0, 0o755, False, False)
        nortropic = root.parent
        if not nortropic.exists(): os.mkdir(nortropic, 0o755)
        safe_dir(nortropic, 0, 0o755, False, False)
        if not root.exists(): os.mkdir(root, 0o755)
    safe_dir(root, owner, 0o755, False)
    layout = (("bin", owner, 0o755), ("probes", owner, 0o755),
              ("evidence", producer_uid, 0o755), ("probe-receipts", owner, 0o755),
              ("state", owner, 0o700))
    for name, uid, mode in layout:
        path = root / name
        if not path.exists(): os.mkdir(path, mode); os.chown(path, uid, group)
        safe_dir(path, uid, mode, False)
    for name in ("pending", "used"):
        path = root / "state" / name
        if not path.exists(): os.mkdir(path, 0o700); os.chown(path, owner, group)
        safe_dir(path, owner, 0o700, False)
    service_mode = 0o755 if fixture else 0o4755
    for name in SERVICES: install_leaf(root / "bin" / name, sources["service"], owner, group, service_mode)
    for name in PROBES: install_leaf(root / "probes" / name, sources["probe"], owner, group, 0o555)
    install_leaf(root / "bin/h034-kernel", sources["h034"], owner, group, 0o555)
    install_leaf(root / "probes.json", sources["allowlist"], owner, group, 0o444)
    print("H033_PROVISIONING=FIXTURE_INSTALLED" if fixture else "H033_PROVISIONING=INSTALLED")


def uninstall():
    if os.geteuid() != 0: stop("root-required")
    try: account = pwd.getpwnam(PRODUCER)
    except KeyError: stop("dedicated-account-missing")
    expected = {**{AUTHORITY / "bin" / n: SERVICE_SHA for n in SERVICES},
                **{AUTHORITY / "probes" / n: PROBE_SHA for n in PROBES},
                AUTHORITY / "bin/h034-kernel": H034_SHA,
                AUTHORITY / "probes.json": ALLOWLIST_SHA}
    for path, wanted in expected.items(): stable_file(path, wanted)
    for directory in (AUTHORITY / "evidence", AUTHORITY / "probe-receipts",
                      AUTHORITY / "state/pending", AUTHORITY / "state/used"):
        if any(os.scandir(directory)): stop("authority-state-not-empty")
    for path in expected: os.unlink(path)
    for directory in (AUTHORITY / "state/pending", AUTHORITY / "state/used", AUTHORITY / "state",
                      AUTHORITY / "evidence", AUTHORITY / "probe-receipts", AUTHORITY / "probes", AUTHORITY / "bin"):
        os.rmdir(directory)
    os.rmdir(AUTHORITY)
    print("H033_PROVISIONING=REMOVED")


def main():
    try:
        if sys.argv[1:] == ["install"]: install(AUTHORITY, False)
        elif sys.argv[1:] == ["uninstall"]: uninstall()
        elif len(sys.argv) == 3 and sys.argv[1] == "fixture-install": install(Path(sys.argv[2]).resolve(), True)
        else: stop("usage")
    except OSError:
        stop("filesystem-operation-failed")


if __name__ == "__main__":
    main()
