#!/usr/bin/python3
"""H-033 protected-origin handoff to the frozen H-034 native kernel."""
import errno
import hashlib
import json
import os
import pwd
import secrets
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
KERNEL = ROOT / "verify/h034/kernel"
KERNEL_MANIFEST = ROOT / "verify/h034/identity-manifest.json"
AUTHORITY = Path("/Library/Application Support/Nortropic/provenance")
EVIDENCE_ROOT = AUTHORITY / "evidence"
RECEIPT_ROOT = AUTHORITY / "probe-receipts"
ALLOWLIST = AUTHORITY / "probes.json"
PRODUCER = "_nortropic_provenance"
PROBES = {
    "h033-auth-pass-v1": "PASS",
    "h033-auth-fail-v1": "FAIL",
    "h033-auth-odombart-v1": "ODÖMBART",
}
DOC_MAX = 1024 * 1024


def fail(code=1):
    raise SystemExit(code)


def strict_options(argv, required, optional=()):
    allowed = set(required) | set(optional)
    if len(argv) % 2:
        fail()
    values = {}
    for index in range(0, len(argv), 2):
        key, value = argv[index:index + 2]
        if not key.startswith("--") or key[2:] not in allowed or key[2:] in values:
            fail()
        values[key[2:]] = value
    if any(key not in values for key in required):
        fail()
    return values


def lower_hex(value, size):
    return len(value) == size and all(ch in "0123456789abcdef" for ch in value)


def validate_bindings(v, include_result=True):
    if v.get("task") != "h-033" or not lower_hex(v.get("candidate", ""), 40):
        fail()
    if not lower_hex(v.get("task-spec-sha256", ""), 64) or not lower_hex(v.get("gate-sha256", ""), 64):
        fail()
    if not v.get("probe") or len(v["probe"].encode()) >= 4096:
        fail()
    if include_result and v.get("require-result") not in ("PASS", "FAIL", "ODÖMBART"):
        fail()


def protected_mode(s):
    return not (s.st_mode & 0o022)


def open_dir_at(parent, name):
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
    s = os.fstat(fd)
    if not stat.S_ISDIR(s.st_mode) or not protected_mode(s):
        os.close(fd); fail()
    return fd


def stable_regular_at(parent, name):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode) or not protected_mode(before) or before.st_nlink != 1:
            fail()
        if before.st_size <= 0 or before.st_size > DOC_MAX:
            fail()
        first = os.pread(fd, before.st_size, 0)
        middle = os.fstat(fd)
        second = os.pread(fd, before.st_size, 0)
        after = os.fstat(fd)
        identity = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_uid, s.st_gid,
                              s.st_size, s.st_mtime_ns, s.st_ctime_ns)
        if len(first) != before.st_size or first != second or identity(before) != identity(middle) or identity(middle) != identity(after):
            fail()
        return fd
    except BaseException:
        os.close(fd)
        raise


def open_authority(root, request_id, fixture):
    root_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    opened = [root_fd]
    try:
        rs = os.fstat(root_fd)
        if not stat.S_ISDIR(rs.st_mode) or not protected_mode(rs):
            fail()
        evidence_dir = open_dir_at(root_fd, "evidence"); opened.append(evidence_dir)
        receipt_dir = open_dir_at(root_fd, "probe-receipts"); opened.append(receipt_dir)
        evidence = stable_regular_at(evidence_dir, request_id + ".json"); opened.append(evidence)
        receipt = stable_regular_at(receipt_dir, request_id + ".json"); opened.append(receipt)
        allowlist = stable_regular_at(root_fd, "probes.json"); opened.append(allowlist)
        stats = [os.fstat(fd) for fd in (evidence, receipt, allowlist)]
        if len({(s.st_dev, s.st_ino) for s in stats}) != 3:
            fail()
        if not fixture:
            producer = pwd.getpwnam(PRODUCER)
            if producer.pw_uid in (0, os.getuid()) or stats[0].st_uid != producer.pw_uid:
                fail(2)
            if stats[1].st_uid != 0 or stats[2].st_uid != 0:
                fail(2)
        return opened, (evidence, receipt, allowlist)
    except BaseException:
        for fd in reversed(opened):
            try: os.close(fd)
            except OSError: pass
        raise


def kernel_handoff(fds, v):
    try:
        manifest_raw = KERNEL_MANIFEST.read_bytes()
        manifest = json.loads(manifest_raw.decode("utf-8"))
        expected_keys = ("schema_version", "language", "artifact_path", "artifact_sha256",
                         "build_recipe_sha256", "source_sha256", "architecture", "file_type",
                         "code_signature", "cdhash", "dylinker", "uuid", "dependencies",
                         "macho_build_version")
        if tuple(manifest) != expected_keys or manifest["schema_version"] != 1 or manifest["language"] != "C":
            fail(2)
        if manifest["artifact_path"] != "verify/h034/kernel" or manifest["architecture"] != "arm64":
            fail(2)
        if manifest["code_signature"] != "adhoc" or not manifest["cdhash"] or not manifest["uuid"]:
            fail(2)
        kernel_fd = os.open(KERNEL, os.O_RDONLY | os.O_NOFOLLOW)
        kernel_exec_fd = os.open(KERNEL, os.O_EXEC | os.O_NOFOLLOW)
        before = os.fstat(kernel_fd)
        executable_stat = os.fstat(kernel_exec_fd)
        if not stat.S_ISREG(before.st_mode) or not (before.st_mode & 0o111) or before.st_nlink != 1:
            fail(2)
        kernel_bytes = os.pread(kernel_fd, before.st_size, 0)
        middle = os.fstat(kernel_fd)
        if len(kernel_bytes) != before.st_size or hashlib.sha256(kernel_bytes).hexdigest() != manifest["artifact_sha256"]:
            fail(2)
        if (before.st_dev, before.st_ino, before.st_mode, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != \
           (middle.st_dev, middle.st_ino, middle.st_mode, middle.st_size, middle.st_mtime_ns, middle.st_ctime_ns):
            fail(2)
        if (before.st_dev, before.st_ino) != (executable_stat.st_dev, executable_stat.st_ino): fail(2)
    except (OSError, UnicodeError, ValueError, KeyError, TypeError):
        fail(2)
    argv = [str(KERNEL), "h033-verify",
            "--evidence-fd", str(fds[0]), "--receipt-fd", str(fds[1]),
            "--allowlist-fd", str(fds[2]), "--task", "h-033",
            "--candidate", v["candidate"], "--task-spec-sha256", v["task-spec-sha256"],
            "--gate-sha256", v["gate-sha256"], "--probe", v["probe"],
            "--request-id", v["request-id"], "--require-result", v["require-result"]]
    process = subprocess.Popen(argv, executable=str(KERNEL), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               text=True, pass_fds=tuple(fds) + (kernel_exec_fd,), start_new_session=True,
                               env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"})
    try:
        out, _ = process.communicate(timeout=3)
    except subprocess.TimeoutExpired:
        try: os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError: pass
        process.communicate()
        os.close(kernel_fd); os.close(kernel_exec_fd); fail(2)
    after = os.fstat(kernel_fd)
    os.close(kernel_fd)
    os.close(kernel_exec_fd)
    if (before.st_dev, before.st_ino, before.st_mode, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != \
       (after.st_dev, after.st_ino, after.st_mode, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
        fail(2)
    if process.returncode == 0:
        sys.stdout.write(out)
        return
    fail(1 if process.returncode == 1 else 2)


def gate_verify(argv):
    required = ("fixture-root", "task", "candidate", "task-spec-sha256", "gate-sha256",
                "probe", "request-id", "require-result")
    v = strict_options(argv, required, ("gate-race-sync",))
    validate_bindings(v)
    if not lower_hex(v["request-id"], 64):
        fail()
    opened, fds = open_authority(Path(v["fixture-root"]), v["request-id"], True)
    try:
        if "gate-race-sync" in v:
            sync = Path(v["gate-race-sync"])
            (sync / "opened").write_text("opened\n")
            deadline = time.monotonic() + 3
            while not (sync / "release").is_file():
                if time.monotonic() >= deadline: fail(2)
                time.sleep(.01)
        kernel_handoff(fds, v)
    finally:
        for fd in reversed(opened):
            try: os.close(fd)
            except OSError: pass


def verify(argv):
    required = ("request-id", "task", "candidate", "task-spec-sha256", "gate-sha256", "probe", "require-result")
    v = strict_options(argv, required)
    validate_bindings(v)
    if not lower_hex(v["request-id"], 64): fail()
    opened, fds = open_authority(AUTHORITY, v["request-id"], False)
    try:
        kernel_handoff(fds, v)
    finally:
        for fd in reversed(opened):
            try: os.close(fd)
            except OSError: pass


def request(argv):
    required = ("task", "candidate", "task-spec-sha256", "gate-sha256", "probe")
    v = strict_options(argv, required)
    validate_bindings(v, False)
    if v["probe"] not in PROBES:
        fail()
    # Creation is deliberately delegated to fixed, independently provisioned
    # OS services. Repository code never fabricates producer/root authority.
    producer = "/Library/Application Support/Nortropic/provenance/bin/request-producer"
    observer = "/Library/Application Support/Nortropic/provenance/bin/request-observer"
    try:
        account = pwd.getpwnam(PRODUCER)
        ps, os_ = os.lstat(producer), os.lstat(observer)
    except (KeyError, OSError):
        fail(2)
    if account.pw_uid in (0, os.getuid()) or ps.st_uid != 0 or os_.st_uid != 0 or not protected_mode(ps) or not protected_mode(os_):
        fail(2)
    request_id = secrets.token_hex(32)
    common = ["--request-id", request_id, "--task", "h-033", "--candidate", v["candidate"],
              "--task-spec-sha256", v["task-spec-sha256"], "--gate-sha256", v["gate-sha256"], "--probe", v["probe"]]
    for executable in (producer, observer):
        q = subprocess.run([executable] + common, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=5, env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"})
        if q.returncode: fail(2)
    print("REQUEST_ID=" + request_id)
    print("EVIDENCE=" + str(EVIDENCE_ROOT / (request_id + ".json")))
    print("RECEIPT=" + str(RECEIPT_ROOT / (request_id + ".json")))


def main():
    if len(sys.argv) < 2: fail()
    command, argv = sys.argv[1], sys.argv[2:]
    if command == "gate-verify": gate_verify(argv)
    elif command == "verify": verify(argv)
    elif command == "request": request(argv)
    else: fail()


if __name__ == "__main__":
    main()
