H034_MANIFEST_SHA256 = "18f57799f091fe4be8a829a1fbbe891f33b57d5f4d8a50df49f755082d5398a1"
SERVICE_SHA256 = "da3b7900d6a24e6297db256186d490de50fee54f4c565710a225909f0638e686"
