#!/usr/bin/env python3.12
"""controller/worker/cli — skiva 6: strikt utdatakontrakt för workerns rapport.

    parse <fil>    giltigt kuvert → exit 0, candidate_sha på stdout
                   allt annat     → exit ≠0, failure-klass på stdout

Rapporten läses mekaniskt eller inte alls. Prosa är ett fel, inte något att
tolka: HELA filen måste vara exakt ett JSON-objekt. Ett kuvert som ligger
inbäddat i prosa plockas ALDRIG ut — att leta upp den sista JSON-liknande
raden i ett textsvar är precis det tolkningsförsök kontraktet förbjuder, och
den välvilligheten är hur en trasig worker råkar bli godkänd.

Failure-klasserna hålls isär med avsikt. Controllern klassar och räknar fel
(v4.1 §13 `classify`, §16 circuit breaker), och två fel som får samma namn
kan inte räknas isär — då öppnar breakern på fel grund eller inte alls:

    empty_output              tomt, eller bara blanktecken
    unparseable_output        inte JSON, eller JSON som inte är ett kuvert
    candidate_sha_not_found   välformat kuvert, men SHA:t finns inte i repot
    internal_error            oväntat fel — en klass, aldrig en traceback

Klassen skrivs på STDOUT, inte stderr. Controllern läser utfallet ur stdout,
och en traceback på stderr är inte en failure-klass utan en krasch.

Exitkoden bär samma klassning, så en anropare slipper strängmatcha:
0 giltigt · 1 felaktigt anrop · 2 empty · 3 unparseable · 4 sha saknas ·
5 internt fel.
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

if sys.version_info < (3, 12):
    sys.exit(f"controller/worker/cli kräver Python 3.12+, kördes på {sys.version.split()[0]}")

ROT = Path(__file__).resolve().parents[2]
KOMMANDON = ("parse",)

# Ett fullt SHA-1, inget annat. Förkortningar är tvetydiga och ett strikt
# utdatakontrakt gissar inte vilken commit workern menade.
# \Z, inte $: i Python matchar $ även FÖRE en avslutande radbrytning, så
# "<40 hex>\n" hade passerat formkontrollen och först senare fallit på
# repo-uppslaget — rätt utfall av fel skäl, och i fel failure-klass.
SHA_FORM = re.compile(r"^[0-9a-fA-F]{40}\Z")

TOM = "empty_output"
OPARSBAR = "unparseable_output"
SHA_SAKNAS = "candidate_sha_not_found"
INTERNT = "internal_error"

KOD = {TOM: 2, OPARSBAR: 3, SHA_SAKNAS: 4, INTERNT: 5}


class IckeStandard(ValueError):
    """Pythons json läser NaN, Infinity och -Infinity. JSON gör det inte.

    RFC 8259 har inga sådana literaler. En parser som ändå tar emot dem
    accepterar indata som ingen annan JSON-läsare i kedjan kan läsa — och ett
    strikt utdatakontrakt som är vidare än standarden är inte strikt.
    """


class Dubblett(ValueError):
    """Samma nyckel två gånger. Pythons json behåller tyst den sista.

    Ett kuvert med två candidate_sha — ett falskt och ett äkta — skulle då
    godkännas på det sista. Vilket som vinner är en implementationsdetalj, och
    att välja åt workern är precis det tolkningsförsök kontraktet förbjuder.
    """


def _konstant(namn: str):
    raise IckeStandard(namn)


def _unika_nycklar(par: list[tuple[str, object]]) -> dict:
    sedda: set[str] = set()
    for nyckel, _ in par:
        if nyckel in sedda:
            raise Dubblett(nyckel)
        sedda.add(nyckel)
    return dict(par)


def klass(namn: str, detalj: str) -> int:
    """Skriver failure-klassen på stdout och ger dess exitkod."""
    print(f"{namn}: {detalj}")
    return KOD[namn]


def anropsfel(text: str) -> int:
    """Fel i anropet självt — inte en failure-klass hos workern."""
    print(text)
    return 1


def git(*argv: str) -> subprocess.CompletedProcess:
    """Git utan skal. argv är en lista — fri text kan aldrig bli ett kommando."""
    return subprocess.run(
        ["git", "-C", str(ROT), *argv],
        capture_output=True,
        text=True,
        check=False,
    )


def las(fil: Path) -> tuple[str | None, int | None]:
    """Filens text, eller (None, exitkod) om den inte går att läsa som text."""
    try:
        rå = fil.read_bytes()
    except OSError as e:
        return None, klass(INTERNT, f"kan inte läsa {fil}: {e.strerror or e}")
    try:
        return rå.decode("utf-8"), None
    except UnicodeDecodeError as e:
        return None, klass(OPARSBAR, f"inte giltig UTF-8 ({e.reason})")


def kuvert_ur(text: str) -> tuple[dict | None, int | None]:
    """Hela texten som ett kuvert, eller (None, exitkod) med klassen satt."""
    if not text.strip():
        return None, klass(TOM, "rapporten innehåller ingenting att läsa")

    try:
        värde = json.loads(text, parse_constant=_konstant, object_pairs_hook=_unika_nycklar)
    except IckeStandard as e:
        return None, klass(OPARSBAR, f"{e} är ingen JSON-literal (RFC 8259 har varken NaN eller Infinity)")
    except Dubblett as e:
        return None, klass(OPARSBAR, f"nyckeln {e} förekommer flera gånger — vilken som gäller är inte definierat")
    except json.JSONDecodeError as e:
        return None, klass(OPARSBAR, f"inte JSON (rad {e.lineno}, kolumn {e.colno}: {e.msg})")

    if not isinstance(värde, dict):
        return None, klass(OPARSBAR, f"JSON men inte ett objekt ({type(värde).__name__})")

    for fält, typ, vad in (("status", str, "en sträng"),
                           ("candidate_sha", str, "en sträng"),
                           ("files", list, "en lista")):
        if fält not in värde:
            return None, klass(OPARSBAR, f"fältet {fält} saknas")
        if not isinstance(värde[fält], typ) or isinstance(värde[fält], bool):
            return None, klass(OPARSBAR, f"fältet {fält} är inte {vad}")

    if värde["status"] != "candidate":
        return None, klass(OPARSBAR, f"status är {värde['status']!r}, inte 'candidate'")

    if not SHA_FORM.match(värde["candidate_sha"]):
        return None, klass(OPARSBAR, "candidate_sha är inte fyrtio hexadecimala tecken")

    if not värde["files"]:
        return None, klass(OPARSBAR, "files är tom — en kandidat utan ändrade filer är ingen kandidat")
    if not all(isinstance(f, str) for f in värde["files"]):
        return None, klass(OPARSBAR, "files innehåller något som inte är en sträng")
    if not all(f.strip() for f in värde["files"]):
        return None, klass(OPARSBAR, "files innehåller en tom sökväg")

    return värde, None


def los_upp_sha(sha: str) -> tuple[str | None, str]:
    """Kandidatens SHA om det självt är en commit i repot, annars (None, skäl).

    `^{commit}` räcker INTE ensamt. Det avvisar tree och blob, men ett
    ANNOTERAT TAGGOBJEKT peelas vidare till commiten taggen pekar på — och då
    blir svaret ett annat SHA än det workern påstod. Mätt 2026-08-08 på taggen
    100d-baseline-20260730: kuvertet bar 7e08d29f (typ tag), komponenten
    svarade exit 0 med 69559a55. En controller hade verifierat och attesterat
    en commit som ingen worker föreslagit — tyst, med tom stderr.

    Därför krävs att det peelade svaret är IDENTISKT med det påstådda. Är det
    inte det var objektet inte självt en commit, och kandidaten avvisas.
    """
    r = git("rev-parse", "--verify", "--quiet", f"{sha}^{{commit}}")
    peelat = r.stdout.strip()
    if r.returncode != 0 or not peelat:
        return None, f"{sha} är ingen commit i repot"
    if peelat != sha.lower():
        typ = git("cat-file", "-t", sha).stdout.strip() or "okänt objekt"
        return None, (f"{sha} är ett {typ}-objekt, inte en commit — det pekar vidare "
                      f"till {peelat}, och den kandidaten påstod workern aldrig")
    return peelat, ""


def gor_parse(fil: Path) -> int:
    text, kod = las(fil)
    if text is None:
        return kod

    kuvert, kod = kuvert_ur(text)
    if kuvert is None:
        return kod

    påstått = kuvert["candidate_sha"]
    sha, skäl = los_upp_sha(påstått)
    if sha is None:
        return klass(SHA_SAKNAS, skäl)

    print(sha)
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] not in KOMMANDON:
        return anropsfel(f"okänt kommando; välj ett av {', '.join(KOMMANDON)}")
    kommando, argv = argv[0], argv[1:]

    if len(argv) != 1:
        return anropsfel(f"{kommando} kräver exakt <fil>")

    return gor_parse(Path(argv[0]))


if __name__ == "__main__":
    # Sista skyddet. Kriteriet säger "failure, inte krasch": ett oväntat fel
    # ska bli en klassad rad på stdout, aldrig ett stackspår på stderr.
    try:
        kod = main(sys.argv[1:])
    except BrokenPipeError:
        # Läsaren har gått. Det finns ingen kanal kvar att rapportera i, och
        # att försöka skriva klassen skulle kasta samma fel en gång till.
        kod = KOD[INTERNT]
    except SystemExit:
        raise
    except BaseException as e:
        try:
            kod = klass(INTERNT, f"{type(e).__name__}: {e}")
        except BrokenPipeError:
            kod = KOD[INTERNT]

    # Tolken spolar stdout vid avslut. Mot ett brutet rör skrev den
    # "Exception ignored in ... BrokenPipeError" på stderr — mätt 2026-08-08.
    # Det är inte en failure-klass, så spolningen görs här i stället, och
    # resten av avslutet får skriva till /dev/null.
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        kod = KOD[INTERNT]
    sys.exit(kod)
