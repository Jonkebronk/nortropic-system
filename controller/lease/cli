#!/usr/bin/env python3.12
"""controller/lease/cli — skiva 4: exklusiv lease.

Exakt en controller äger en task åt gången. Exklusiviteten vilar på
O_CREAT|O_EXCL — en atomär operation i filsystemet, inte på en läs-sen-skriv
som 100 samtidiga starter hade sluppit förbi.

    [<dir>] acquire <task> --ttl <sek>   tar leasen om den är fri
    [<dir>] release <task>               släpper leasen
    [<dir>] owner <task>                 skriver innehavaren, tomt om ingen

Katalogen är valfri och ligger först; utelämnad ger controller/lease/state/.

Exit 0 = leasen är din / kommandot lyckades. Exit 1 = den ägs av någon annan,
eller fel.
"""

import json
import os
import re
import sys
import time
from pathlib import Path

if sys.version_info < (3, 12):
    sys.exit(f"controller/lease/cli kräver Python 3.12+, kördes på {sys.version.split()[0]}")

ROT = Path(__file__).resolve().parents[2]
KOMMANDON = ("acquire", "release", "owner")
# Tasknamnet blir ett filnamn. Utan denna spärr är ../../ ett giltigt tasknamn.
TASK_FORM = re.compile(r"^[A-Za-z0-9._-]+$")


def fel(text: str) -> int:
    print(text, file=sys.stderr)
    return 1


def lease_fil(kat: Path, task: str) -> Path:
    return kat / f"{task}.lease"


def jag() -> str:
    return f"{os.uname().nodename}:{os.getpid()}"


def las_lease(p: Path) -> dict | None:
    try:
        with p.open(encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def skapa_exklusivt(p: Path, data: dict) -> bool:
    """Enda vägen till ägarskap. O_EXCL gör att exakt en process vinner."""
    p.parent.mkdir(parents=True, exist_ok=True)
    try:
        fd = os.open(p, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    except FileExistsError:
        return False
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, sort_keys=True)
        f.write("\n")
    return True


def utgangen(lease: dict) -> bool:
    """Har leasen löpt ut?

    Utgången mäts med TVÅ klockor och kräver att båda är överens.

    Väggklockan (time.time) är den enda som är jämförbar mellan processer över
    tid, men den kan hoppa — NTP-korrigering, manuell ändring, virtualisering.
    Ett hopp FRAMÅT hos den process som läser är skevheten åt fel håll: leasen
    ser utgången ut medan innehavaren fortfarande tror sig äga den, och två
    processer äger samma task. Den monotona klockan kan inte hoppa och används
    därför som spärr mot just det.

    Kravet är att BÅDA klockorna säger att ttl förflutit. Ett väggklockshopp
    framåt blåser upp vagg_forfluten men lämnar mono_forfluten sann, och
    leasen behålls. Ett hopp bakåt krymper vagg_forfluten, och leasen behålls
    också. Åt båda hållen vägrar vi hellre än tillåter dubbelägande.

    Undantaget är omstart. time.monotonic räknas från uppstart, så efter en
    omstart blir mono_forfluten negativ. Det kan bara betyda att maskinen
    startat om — och då är innehavarprocessen med säkerhet död, så väggklockan
    får avgöra ensam. Utan undantaget hade en lease som överlevt en omstart
    blockerat för alltid.
    """
    ttl = lease["ttl"]
    vagg_forfluten = time.time() - lease["beviljad_vagg"]
    mono_forfluten = time.monotonic() - lease["beviljad_mono"]
    if mono_forfluten < 0:
        return vagg_forfluten >= ttl
    return vagg_forfluten >= ttl and mono_forfluten >= ttl


def kmd_acquire(kat: Path, task: str, ttl: float) -> int:
    data = {
        "task": task,
        "agare": jag(),
        "ttl": ttl,
        "beviljad_vagg": time.time(),
        "beviljad_mono": time.monotonic(),
    }
    p = lease_fil(kat, task)
    if skapa_exklusivt(p, data):
        return 0

    # Filen fanns. Bara en utgången lease får tas över.
    ravar = p.read_bytes() if p.exists() else None
    lease = las_lease(p)
    if lease is None:
        return fel(f"acquire: {task} har en oläsbar lease — vägrar hellre än gissar")
    if not utgangen(lease):
        return fel(f"acquire: {task} ägs av {lease['agare']}")

    # Ta bort den utgångna leasen bara om den fortfarande är exakt den vi
    # dömde. Hann någon annan skriva en färsk däremellan rör vi den aldrig.
    try:
        if p.read_bytes() != ravar:
            return fel(f"acquire: {task} togs av någon annan")
        p.unlink()
    except OSError:
        pass
    if skapa_exklusivt(p, data):
        return 0
    return fel(f"acquire: {task} togs av någon annan")


def kmd_release(kat: Path, task: str) -> int:
    lease_fil(kat, task).unlink(missing_ok=True)
    return 0


def kmd_owner(kat: Path, task: str) -> int:
    lease = las_lease(lease_fil(kat, task))
    if lease is None or utgangen(lease):
        return fel(f"owner: {task} ägs inte")
    print(lease["agare"])
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return fel("användning: cli [<dir>] acquire <task> --ttl <sek> | release <task> | owner <task>")
    if argv[1] in KOMMANDON:
        kat, arg = ROT / "controller" / "lease" / "state", argv[1:]
    else:
        kat, arg = Path(argv[1]), argv[2:]
    if len(arg) < 2:
        return fel("användning: cli [<dir>] acquire <task> --ttl <sek> | release <task> | owner <task>")

    kommando, task = arg[0], arg[1]
    if not TASK_FORM.match(task):
        return fel(f"otillåtet tasknamn: {task}")

    if kommando == "acquire":
        if len(arg) != 4 or arg[2] != "--ttl":
            return fel("användning: cli [<dir>] acquire <task> --ttl <sek>")
        try:
            ttl = float(arg[3])
        except ValueError:
            return fel(f"--ttl kräver ett tal, fick {arg[3]}")
        if ttl <= 0:
            return fel(f"--ttl måste vara positiv, fick {ttl}")
        return kmd_acquire(kat, task, ttl)
    if kommando == "release":
        return kmd_release(kat, task)
    if kommando == "owner":
        return kmd_owner(kat, task)
    return fel(f"okänt kommando: {kommando}")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
